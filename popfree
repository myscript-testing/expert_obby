local camera = workspace.CurrentCamera
local camYaw = 0
local camPitch = -0.24
local camVelocityYaw = 0
local defaultCamDistance = 12.5
local currentCamDistance = 12.5

local cameraRayParams = RaycastParams.new()
cameraRayParams.FilterType = Enum.RaycastFilterType.Exclude
cameraRayParams.IgnoreWater = true

local function getShortestAngleDiff(targetAngle, currentAngle)
    return (targetAngle - currentAngle + math.pi) % (2 * math.pi) - math.pi
end

local function updateHumanMouseCamera(hrpPosition, targetFacingYaw, dt, now, isAirborne)
    if not isPlaying or not isRunningScript or not cameraToggleEnabled then return end
    
    pcall(function()
        if not camera or camera.Parent == nil then
            camera = workspace.CurrentCamera
        end
        if camera.CameraType ~= Enum.CameraType.Scriptable then
            camera.CameraType = Enum.CameraType.Scriptable
        end
        
        local yawDiff = getShortestAngleDiff(targetFacingYaw, camYaw)
        
        local swipeSens = (math.abs(yawDiff) > 0.5) and 8.5 or 6.2
        if isAirborne then swipeSens = swipeSens * 0.85 end
        
        local mouseFriction = 0.82
        camVelocityYaw = (camVelocityYaw + yawDiff * swipeSens * dt) * math.pow(mouseFriction, dt * 60)
        camYaw = (camYaw + camVelocityYaw * dt + math.pi) % (2 * math.pi) - math.pi
        
        local microJitterY = (math.sin(now * 2.2) * 0.004) + ((math.random() - 0.5) * 0.002)
        local targetPitch = -0.24 + microJitterY
        camPitch = camPitch + (targetPitch - camPitch) * math.clamp(5.0 * dt, 0, 0.35)
        
        local focusPoint = hrpPosition + Vector3.new(0, 2.0, 0)
        local rotCFrame = CFrame.Angles(0, camYaw, 0) * CFrame.Angles(camPitch, 0, 0)
        
        local char = LocalPlayer.Character
        if char then
            cameraRayParams.FilterDescendantsInstances = {char}
        end
        local rayDir = -rotCFrame.LookVector * defaultCamDistance
        local rayResult = workspace:Raycast(focusPoint, rayDir, cameraRayParams)
        
        local targetDist = defaultCamDistance
        if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
            targetDist = math.clamp(rayResult.Distance - 0.4, 2.5, defaultCamDistance)
        end
        currentCamDistance = currentCamDistance + (targetDist - currentCamDistance) * math.clamp(14.0 * dt, 0, 0.5)
        
        local camPos = focusPoint - (rotCFrame.LookVector * currentCamDistance)
        camera.CFrame = CFrame.new(camPos, focusPoint)
    end)
end

