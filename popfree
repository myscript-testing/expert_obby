    if isReconnecting or not autoReconnectEnabled or not isRunningScript then return end
    isReconnecting = true
    
    warn("[AutoReconnect] Connection lost / error detected. Initiating reconnect...")
    
    task.spawn(function()
        while isRunningScript do
            task.wait(3.5)
            local success, _ = pcall(function()
                if #Players:GetPlayers() <= 1 then
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                else
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                end
            end)
            
            if not success then
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
            end
            task.wait(4.5)
        end
    end)
end

