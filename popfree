local function getGlobal(name)
    local val = nil
    pcall(function()
        if typeof(getgenv) == "function" and getgenv()[name] ~= nil then
            val = getgenv()[name]
        elseif _G and _G[name] ~= nil then
            val = _G[name]
        elseif shared and shared[name] ~= nil then
            val = shared[name]
        end
    end)
    if val ~= nil then return val end
    pcall(function()
        local g = (typeof(getfenv) == "function" and getfenv()) or {}
        val = g[name]
    end)
    return val
end

local _writefile = (typeof(writefile) == "function" and writefile) or getGlobal("writefile") or (syn and syn.writefile) or (fluxus and fluxus.writefile)
local _readfile = (typeof(readfile) == "function" and readfile) or getGlobal("readfile") or (syn and syn.readfile) or (fluxus and fluxus.readfile)
local _isfile = (typeof(isfile) == "function" and isfile) or getGlobal("isfile") or (syn and syn.isfile) or (fluxus and fluxus.isfile)
local _setfpscap = (typeof(setfpscap) == "function" and setfpscap) or getGlobal("setfpscap") or (syn and syn.setfpscap) or (fluxus and fluxus.setfpscap)

local function safeWriteFile(filename, dataStr)
    local written = false
    local wf = (typeof(writefile) == "function" and writefile) or _writefile or getGlobal("writefile")
    if typeof(wf) == "function" then
        pcall(function()
            wf(filename, dataStr)
            written = true
        end)
    end
    pcall(function()
        if typeof(getgenv) == "function" then getgenv().ExpertObbySavedConfig = dataStr end
        _G.ExpertObbySavedConfig = dataStr
        if shared then shared.ExpertObbySavedConfig = dataStr end
    end)
    return written
end

local function safeReadFile(filename)
    local rf = (typeof(readfile) == "function" and readfile) or _readfile or getGlobal("readfile")
    local isf = (typeof(isfile) == "function" and isfile) or _isfile or getGlobal("isfile")
    if typeof(rf) == "function" then
        local ok, res = pcall(function()
            if typeof(isf) == "function" then
                if isf(filename) then return rf(filename) end
            else
                return rf(filename)
            end
            return nil
        end)
        if ok and res and typeof(res) == "string" and #res > 0 then
            return res
        end
    end
    local mem = nil
    pcall(function()
        if typeof(getgenv) == "function" and getgenv().ExpertObbySavedConfig then
            mem = getgenv().ExpertObbySavedConfig
        elseif _G.ExpertObbySavedConfig then
            mem = _G.ExpertObbySavedConfig
        elseif shared and shared.ExpertObbySavedConfig then
            mem = shared.ExpertObbySavedConfig
        end
    end)
    if mem and typeof(mem) == "string" and #mem > 0 then
        return mem
    end
    return nil
end

