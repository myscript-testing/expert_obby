-- ========================================================
-- AFK MOVEMENT SIGNAL KEEPALIVE
-- Based on save.rbxlx: the game's AFK watcher resets its timer
-- whenever Humanoid.MoveDirection.Magnitude > 0.05.
-- Instead of intercepting AFKModeEvent, keep a small real movement
-- input active and periodically vary it so MoveDirection changes.
-- This leaves the game's AFK RemoteEvent logic untouched.
-- ========================================================
local afkMovementKeepaliveConnection = nil
local afkMovementCharacterConnection = nil
local afkMovementToken = 0

local function stopAfkMovementKeepalive()
    afkMovementToken += 1
    if afkMovementKeepaliveConnection then
        pcall(function() afkMovementKeepaliveConnection:Disconnect() end)
        afkMovementKeepaliveConnection = nil
    end
    if afkMovementCharacterConnection then
        pcall(function() afkMovementCharacterConnection:Disconnect() end)
        afkMovementCharacterConnection = nil
    end
    pcall(function()
        local character = LocalPlayer and LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:Move(Vector3.zero, false)
        end
    end)
end

local function startAfkMovementKeepalive()
    stopAfkMovementKeepalive()
    local token = afkMovementToken
    local phase = false
    local lastPulse = 0

    local function pulse()
        if token ~= afkMovementToken or not isRunningScript then
            return
        end
        local character = LocalPlayer and LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            return
        end

        -- Both values stay above the game's 0.05 threshold while changing
        -- slightly between pulses so GetPropertyChangedSignal can fire.
        phase = not phase
        local amount = phase and 0.061 or 0.062
        humanoid:Move(Vector3.new(0, 0, amount), false)
        lastPulse = os.clock()
    end

    afkMovementKeepaliveConnection = RunService.Heartbeat:Connect(function()
        if token ~= afkMovementToken or not isRunningScript then
            return
        end
        if os.clock() - lastPulse >= 1.0 then
            pulse()
        end
    end)

    afkMovementCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        if token ~= afkMovementToken or not isRunningScript then
            return
        end
        task.defer(function()
            local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
            if humanoid and token == afkMovementToken and isRunningScript then
                phase = not phase
                humanoid:Move(Vector3.new(0, 0, phase and 0.061 or 0.062), false)
                lastPulse = os.clock()
            end
        end)
    end)

    pulse()
end

