local function __verify_hwid()
    local allowed_hwids = {
        ["48b2f42344b0d8636315bf21e3c58641c25fcc87c77a98ff9379a063a7127d3a"] = true,
        ["7b66393562366263622d306139312d313166312d616664342d3830366536663665363936337d"] = true,
    }

    local current_hwid = nil

    local function normalize(id)
        if typeof(id) == "string" then
            local cleaned = string.gsub(id, "[%s{}]", "")
            return string.lower(cleaned)
        end
        return nil
    end

    pcall(function()
        if typeof(gethwid) == "function" then
            current_hwid = normalize(gethwid())
        elseif typeof(get_hwid) == "function" then
            current_hwid = normalize(get_hwid())
        elseif syn and typeof(syn.get_hardware_id) == "function" then
            current_hwid = normalize(syn.get_hardware_id())
        elseif fluxus and typeof(fluxus.get_hwid) == "function" then
            current_hwid = normalize(fluxus.get_hwid())
        end
    end)

    if not current_hwid then
        pcall(function()
            local rbxAnalytics = game:GetService("RbxAnalyticsService")
            current_hwid = normalize(rbxAnalytics:GetClientId())
        end)
    end

    if not current_hwid or not allowed_hwids[current_hwid] then
        local Players = game:GetService("Players")
        local localPlayer = Players.LocalPlayer
        if localPlayer then
            pcall(function()
                localPlayer:Kick("[HWID Lock] HWID non autorise / Unauthorized HWID: " .. tostring(current_hwid))
            end)
        end
        error("[HWID Lock] HWID non autorise: " .. tostring(current_hwid), 0)
        return false
    end
    return true
end

if not __verify_hwid() then
    return
end
