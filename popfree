-- =============================================================================
-- CaptchaManager
-- LocalScript module — integrated into the primary client script.
--
-- This module does NOT solve, click, hide, destroy, or bypass CAPTCHAs.
-- It watches the legitimate BindChallenge event, displays a lightweight
-- instruction overlay, and exposes IsActive()/RequestCaptcha() so the macro
-- can suspend its own playback timing until the server removes the challenge.
-- =============================================================================

local CaptchaManager = (function()

    -- -------------------------------------------------------------------------
    -- Services
    -- -------------------------------------------------------------------------
    local Players           = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local TweenService      = game:GetService("TweenService")

    local LocalPlayer = Players.LocalPlayer
    local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui", 30)

    if not PlayerGui then
        return nil
    end

    -- -------------------------------------------------------------------------
    -- Remote references
    -- -------------------------------------------------------------------------
    local ImageCaptchaRemotes = ReplicatedStorage:WaitForChild("ImageCaptchaRemotes", 30)
    if not ImageCaptchaRemotes then
        return nil
    end

    local BindChallenge = ImageCaptchaRemotes:WaitForChild("BindChallenge", 10)
    local RenderStatus  = ImageCaptchaRemotes:WaitForChild("RenderStatus", 10)

    if not BindChallenge or not RenderStatus then
        return nil
    end

    -- -------------------------------------------------------------------------
    -- CaptchaState — single source of truth
    -- -------------------------------------------------------------------------
    local managerEnabled = true

    local CaptchaState = {
        active          = false,
        challengeId     = nil,
        overlayGui      = nil,
        challengeGui    = nil,
        connections     = {},
        pendingResume   = nil,
        validationTimer = nil,
    }

    local OVERLAY_ZINDEX    = 99
    local CHALLENGE_TIMEOUT = 180

    local function disconnectAll()
        for _, conn in ipairs(CaptchaState.connections) do
            if conn and conn.Connected then
                conn:Disconnect()
            end
        end
        table.clear(CaptchaState.connections)
    end

    local function trackConnection(conn)
        table.insert(CaptchaState.connections, conn)
    end

    local function ShowCaptchaUI()
        if CaptchaState.overlayGui then
            return
        end

        local overlay = Instance.new("ScreenGui")
        overlay.Name           = "CaptchaManagerOverlay"
        overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        overlay.DisplayOrder   = OVERLAY_ZINDEX
        overlay.ResetOnSpawn   = false
        overlay.IgnoreGuiInset = true

        local backdrop = Instance.new("Frame")
        backdrop.Size = UDim2.fromScale(1, 1)
        backdrop.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
        backdrop.BackgroundTransparency = 1
        backdrop.BorderSizePixel = 0
        backdrop.ZIndex = 1
        backdrop.Parent = overlay

        local card = Instance.new("Frame")
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.Position = UDim2.fromScale(0.5, 0.5)
        card.Size = UDim2.fromOffset(420, 110)
        card.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
        card.BackgroundTransparency = 1
        card.BorderSizePixel = 0
        card.ZIndex = 2
        card.Parent = overlay

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 12)
        corner.Parent = card

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(90, 90, 140)
        stroke.Thickness = 1.2
        stroke.Transparency = 1
        stroke.Parent = card

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -24, 1, 0)
        label.Position = UDim2.fromOffset(12, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(220, 220, 240)
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 15
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.Text = "🔒  Human verification required\n\nPlease complete the image challenge to continue."
        label.TextTransparency = 1
        label.ZIndex = 3
        label.Parent = card

        overlay.Parent = PlayerGui
        CaptchaState.overlayGui = overlay

        local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(backdrop, tweenInfo, {BackgroundTransparency = 0.55}):Play()
        TweenService:Create(card, tweenInfo, {BackgroundTransparency = 0}):Play()
        TweenService:Create(stroke, tweenInfo, {Transparency = 0}):Play()
        TweenService:Create(label, tweenInfo, {TextTransparency = 0}):Play()
    end

    local function HideCaptchaUI()
        local overlay = CaptchaState.overlayGui
        if not overlay or not overlay.Parent then
            return
        end

        CaptchaState.overlayGui = nil

        local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        for _, desc in ipairs(overlay:GetDescendants()) do
            if desc:IsA("Frame") then
                TweenService:Create(desc, tweenInfo, {BackgroundTransparency = 1}):Play()
            elseif desc:IsA("TextLabel") then
                TweenService:Create(desc, tweenInfo, {
                    BackgroundTransparency = 1,
                    TextTransparency = 1,
                }):Play()
            end
        end

        task.delay(0.4, function()
            if overlay and overlay.Parent then
                overlay:Destroy()
            end
        end)
    end

    local function ResetActiveChallenge()
        -- Keep the BindChallenge subscription alive; only clear the active
        -- challenge-specific watcher/timer.
        for i = #CaptchaState.connections, 2, -1 do
            local conn = CaptchaState.connections[i]
            if conn and conn.Connected then
                conn:Disconnect()
            end
            table.remove(CaptchaState.connections, i)
        end

        if CaptchaState.validationTimer then
            task.cancel(CaptchaState.validationTimer)
            CaptchaState.validationTimer = nil
        end

        HideCaptchaUI()

        CaptchaState.active = false
        CaptchaState.challengeId = nil
        CaptchaState.challengeGui = nil
        CaptchaState.pendingResume = nil
    end

    local function CleanupCaptcha()
        disconnectAll()
        ResetActiveChallenge()
    end

    local function OnCaptchaValidated(timedOut)
        if not CaptchaState.active then
            return
        end

        local resumeCallback = CaptchaState.pendingResume
        CleanupCaptcha()

        if resumeCallback then
            task.spawn(resumeCallback, not timedOut)
        end
    end

    local function RequestCaptcha()
        if not CaptchaState.active then
            return true
        end

        local previousResume = CaptchaState.pendingResume
        local thread = coroutine.running()

        CaptchaState.pendingResume = function(success)
            if previousResume then
                previousResume(success)
            end
            if thread then
                task.spawn(thread, success)
            end
        end

        return coroutine.yield()
    end

    local function DetectCaptcha()
        trackConnection(BindChallenge.OnClientEvent:Connect(function(
            challengeGui,
            imageLabel,
            challengeId
        )
            if not managerEnabled then
                return
            end

            if typeof(challengeGui) ~= "Instance"
                or not challengeGui:IsA("ScreenGui")
                or not challengeGui:IsDescendantOf(PlayerGui)
                or typeof(imageLabel) ~= "Instance"
                or not imageLabel:IsA("ImageLabel")
                or not imageLabel:IsDescendantOf(challengeGui)
                or type(challengeId) ~= "string"
            then
                return
            end

            if CaptchaState.active and CaptchaState.challengeGui == challengeGui then
                return
            end

            if CaptchaState.active then
                ResetActiveChallenge()
            end

            CaptchaState.active = true
            CaptchaState.challengeId = challengeId
            CaptchaState.challengeGui = challengeGui

            ShowCaptchaUI()

            trackConnection(challengeGui.AncestryChanged:Connect(function(_, newParent)
                if newParent ~= nil and challengeGui:IsDescendantOf(PlayerGui) then
                    return
                end
                OnCaptchaValidated(false)
            end))

            CaptchaState.validationTimer = task.delay(CHALLENGE_TIMEOUT, function()
                if CaptchaState.active and CaptchaState.challengeId == challengeId then
                    OnCaptchaValidated(true)
                end
            end)
        end))
    end

    DetectCaptcha()

    return {
        RequestCaptcha = RequestCaptcha,
        IsActive = function()
            return managerEnabled and CaptchaState.active
        end,
        IsEnabled = function()
            return managerEnabled
        end,
        SetEnabled = function(value)
            managerEnabled = value == true
            if not managerEnabled and CaptchaState.active then
                ResetActiveChallenge()
            end
        end,
        ForceCleanup = CleanupCaptcha,
    }
end)()

