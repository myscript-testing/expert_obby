-- ========================================================
-- TIMELINE OPTIMIZATION: NATURAL DEAD-TIME & PAUSE COMPRESSION
-- ========================================================

local function sanitizeTimelineFrames(rawFrames)
    if not rawFrames or typeof(rawFrames) ~= "table" or #rawFrames == 0 then
        return {}
    end
    
    local cleaned = {}
    local timeOffset = 0
    local lastValidT = rawFrames[1].t
    local lastPos = rawFrames[1].c.Position
    local staticDuration = 0
    
    for i = 1, #rawFrames do
        local f = rawFrames[i]
        local dt = f.t - lastValidT
        local dist = (f.c.Position - lastPos).Magnitude
        
        if dist < 0.035 and not f.j then
            staticDuration = staticDuration + dt
            if staticDuration > 0.08 then
                timeOffset = timeOffset + (dt * 0.82)
            end
        else
            staticDuration = 0
        end
        
        lastValidT = f.t
        lastPos = f.c.Position
        
        local adjustedT = math.max(0, f.t - timeOffset)
        table.insert(cleaned, {
            t = adjustedT,
            c = f.c,
            j = f.j
        })
    end
    
    return cleaned
end

local sourceFrames = (typeof(frames) == "table" and frames) or (typeof(_G.frames) == "table" and _G.frames) or ((typeof(getgenv) == "function" and typeof(getgenv().frames) == "table") and getgenv().frames) or {}
local activeTimelineFrames = sanitizeTimelineFrames(sourceFrames)

