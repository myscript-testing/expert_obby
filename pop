    CaptchaManager.SetEnabled(antiCaptchaEnabled)
end
updateUIState()
if cpuSaverEnabled then setCpuSaver(true) end
if gpuSaverEnabled then setGpuSaver(true) end
if renderBoostEnabled then setRenderBoost(true) end

-- The external executor reloads the script after a transition. loadSettings()
-- above restores runEnabled without any internal teleport-continuation state.
if runEnabled then
    task.spawn(function()
        task.wait(0.6)
        if not isRunningScript then return end
        local char = waitForReadyCharacter(30)
        if not char then
            warn("[AutoResume] Character did not become ready; the playback worker will retry.")
        end
        task.wait(0.4)
        
        if runEnabled and not isPlaying and isRunningScript then
            warn("[AutoResume] Automatically starting run from saved state...")
            startPlayback()
        end
    end)
end
