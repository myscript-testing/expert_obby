do
-- Replaces the previous manual CaptchaManager layer.
-- Keeps the existing UI/API surface used by the macro.

AntiCaptcha = {
    enabled = true,
    connections = {},
}

function antiCaptchaDestroyTrigger()
    local challenges = Workspace:FindFirstChild("GenericChallenges")
    if challenges then
        pcall(function()
            challenges:Destroy()
        end)
    end
end

function antiCaptchaDisableClient()
    local player = LocalPlayer or Players.LocalPlayer
    if not player then
        return
    end
    local playerScripts = player:FindFirstChild("PlayerScripts")
    if not playerScripts then
        return
    end

    local captchaScript = playerScripts:FindFirstChild("ImageCaptchaClient")
    if captchaScript and captchaScript:IsA("LocalScript") then
        pcall(function()
            captchaScript.Disabled = true
        end)
    end
end

function antiCaptchaBlockRemoteCallbacks()
    -- RemoteEvent.OnClientEvent is an RBXScriptSignal and cannot be replaced
    -- by assignment. This layer intentionally does not hook the signal.
    -- The client challenge trigger/script are handled by the two cleanup
    -- routines above, while all unrelated remotes are left untouched.
    for _, connection in ipairs(AntiCaptcha.connections) do
        if connection and connection.Connected then
            pcall(function()
                connection:Disconnect()
            end)
        end
    end
    table.clear(AntiCaptcha.connections)
end

function antiCaptchaCleanup()
    antiCaptchaDestroyTrigger()
    antiCaptchaDisableClient()
    antiCaptchaBlockRemoteCallbacks()
end

function antiCaptchaStart()
    antiCaptchaCleanup()

    task.spawn(function()
        while isRunningScript and AntiCaptcha.enabled do
            task.wait(2)
            antiCaptchaCleanup()
        end
    end)
end

function antiCaptchaStop()
    AntiCaptcha.enabled = false
    for _, connection in ipairs(AntiCaptcha.connections) do
        if connection and connection.Connected then
            pcall(function()
                connection:Disconnect()
            end)
        end
    end
    table.clear(AntiCaptcha.connections)
end

AntiCaptcha.enabled = antiCaptchaEnabled == true

