function setupCharacterAnimations(character, humanoid)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    
    local idleId = nil
    local walkId = nil
    local jumpId = nil
    
    local animateScript = character:FindFirstChild("Animate")
    if animateScript then
        local idleObj = animateScript:FindFirstChild("idle")
        if idleObj then
            local anim = idleObj:FindFirstChildOfClass("Animation") or idleObj:FindFirstChild("Animation1") or idleObj:FindFirstChild("Animation2")
            if anim and anim.AnimationId ~= "" then idleId = anim.AnimationId end
        end
        local walkObj = animateScript:FindFirstChild("walk") or animateScript:FindFirstChild("run")
        if walkObj then
            local anim = walkObj:FindFirstChildOfClass("Animation") or walkObj:FindFirstChild("WalkAnim") or walkObj:FindFirstChild("RunAnim")
            if anim and anim.AnimationId ~= "" then walkId = anim.AnimationId end
        end
        local jumpObj = animateScript:FindFirstChild("jump")
        if jumpObj then
            local anim = jumpObj:FindFirstChildOfClass("Animation") or jumpObj:FindFirstChild("JumpAnim")
            if anim and anim.AnimationId ~= "" then jumpId = anim.AnimationId end
        end
    end
    
    local isR15 = (humanoid.RigType == Enum.HumanoidRigType.R15)
    if not idleId or idleId == "" then
        idleId = isR15 and "rbxassetid://507766666" or "rbxassetid://180435571"
    end
    if not walkId or walkId == "" then
        walkId = isR15 and "rbxassetid://913376220" or "rbxassetid://180436334"
    end
    if not jumpId or jumpId == "" then
        jumpId = isR15 and "rbxassetid://507765000" or "rbxassetid://125750702"
    end
    
    local idleAnim = Instance.new("Animation")
    idleAnim.AnimationId = idleId
    local idleTrack = animator:LoadAnimation(idleAnim)
    idleTrack.Priority = Enum.AnimationPriority.Idle
    idleTrack.Looped = true
    idleTrack:Play(0.2, 1.0, 1.0)
    idleTrack:AdjustWeight(1.0, 0.05)
    
    local walkAnim = Instance.new("Animation")
    walkAnim.AnimationId = walkId
    local walkTrack = animator:LoadAnimation(walkAnim)
    walkTrack.Priority = Enum.AnimationPriority.Movement
    walkTrack.Looped = true
    walkTrack:AdjustWeight(0.0, 0)
    
    local jumpAnim = Instance.new("Animation")
    jumpAnim.AnimationId = jumpId
    local jumpTrack = animator:LoadAnimation(jumpAnim)
    jumpTrack.Priority = Enum.AnimationPriority.Action
    jumpTrack.Looped = true
    jumpTrack:AdjustWeight(0.0, 0)
    
    return idleTrack, walkTrack, jumpTrack
end

