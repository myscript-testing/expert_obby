-- ========================================================
-- RUNTIME / EXECUTOR ADAPTER
-- Centralise les primitives d'environnement pour que le moteur de playback
-- ne dépende pas directement de syn/fluxus/getgenv/hookmetamethod.
-- ========================================================
local RuntimeAdapter = {}

function RuntimeAdapter.getGlobal(name)
    local val = nil
    pcall(function()
        if typeof(getgenv) == "function" then
            local env = getgenv()
            if env and env[name] ~= nil then val = env[name] end
        end
        if val == nil and _G and _G[name] ~= nil then val = _G[name] end
        if val == nil and shared and shared[name] ~= nil then val = shared[name] end
    end)
    return val
end

function RuntimeAdapter.resolveFunction(name)
    local candidate = nil
    pcall(function()
        if typeof(rawget(_G, name)) == "function" then candidate = rawget(_G, name) end
        if candidate == nil and typeof(getgenv) == "function" and typeof(getgenv()[name]) == "function" then
            candidate = getgenv()[name]
        end
        if candidate == nil and __syn and typeof(__syn[name]) == "function" then candidate = __syn[name] end
        if candidate == nil and __fluxus and typeof(__fluxus[name]) == "function" then candidate = __fluxus[name] end
    end)
    return candidate
end

function RuntimeAdapter.getFileAPI(name)
    return RuntimeAdapter.resolveFunction(name)
end

function RuntimeAdapter.setShared(key, value)
    pcall(function()
        if typeof(getgenv) == "function" then getgenv()[key] = value end
        _G[key] = value
        if shared then shared[key] = value end
    end)
end

function RuntimeAdapter.getShared(key)
    local value = nil
    pcall(function()
        if typeof(getgenv) == "function" and getgenv()[key] ~= nil then value = getgenv()[key] end
        if value == nil and _G[key] ~= nil then value = _G[key] end
        if value == nil and shared and shared[key] ~= nil then value = shared[key] end
    end)
    return value
end

-- Hook installation remains optional and isolated from playback.
function RuntimeAdapter.installNamecallHook(target, predicate)
    if not (target and hookmetamethod and getnamecallmethod and newcclosure) then
        return false
    end
    local installed = false
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local decision, handled = predicate(self, method, ...)
            if handled then return decision end
            return oldNamecall(self, ...)
        end))
        installed = oldNamecall ~= nil
    end)
    return installed
end

function getGlobal(name)
    local val = RuntimeAdapter.getGlobal(name)
    if val ~= nil then return val end
    pcall(function()
        local g = (typeof(getfenv) == "function" and getfenv()) or {}
        val = g[name]
    end)
    return val
end

local _writefile = (typeof(writefile) == "function" and writefile) or RuntimeAdapter.getFileAPI("writefile") or getGlobal("writefile")
local _readfile = (typeof(readfile) == "function" and readfile) or RuntimeAdapter.getFileAPI("readfile") or getGlobal("readfile")
local _isfile = (typeof(isfile) == "function" and isfile) or RuntimeAdapter.getFileAPI("isfile") or getGlobal("isfile")
local _setfpscap = (typeof(setfpscap) == "function" and setfpscap) or RuntimeAdapter.getFileAPI("setfpscap") or getGlobal("setfpscap")

function safeWriteFile(filename, dataStr)
    local written = false
    local wf = (typeof(writefile) == "function" and writefile) or _writefile or getGlobal("writefile")
    if typeof(wf) == "function" then
        pcall(function()
            wf(filename, dataStr)
            written = true
        end)
    end
    RuntimeAdapter.setShared("ExpertObbySavedConfig", dataStr)
    return written
end

function safeReadFile(filename)
    local rf = (typeof(readfile) == "function" and readfile) or _readfile or getGlobal("readfile")
    local isf = (typeof(isfile) == "function" and isfile) or _isfile or getGlobal("isfile")
    if typeof(rf) == "function" then
        local ok, res = pcall(function()
            if typeof(isf) == "function" then
                if isf(filename) then return rf(filename) end
            else
                return rf(filename)
            end
            return nil
        end)
        if ok and res and typeof(res) == "string" and #res > 0 then
            return res
        end
    end
    local mem = nil
    mem = RuntimeAdapter.getShared("ExpertObbySavedConfig")
    if mem and typeof(mem) == "string" and #mem > 0 then
        return mem
    end
    return nil
end

pcall(function()
    local cleanup = RuntimeAdapter.getShared("ExpertObbyCleanup")
    if typeof(cleanup) == "function" then cleanup() end
end)

-- ========================================================
-- PLAYBACK MOTION CONTROLLER + TELEMETRY
-- Centralise l'application du mouvement et calcule des métriques de recherche.
-- ========================================================
local MotionController = {}
MotionController.__index = MotionController

function MotionController.new()
    return setmetatable({
        lastPos = nil,
        lastVelocity = Vector3.zero,
        lastYaw = 0,
        samples = 0,
        maxSpeed = 0,
        maxAcceleration = 0,
        maxJerk = 0,
        lastAcceleration = Vector3.zero,
        sumDt = 0,
    }, MotionController)
end

function MotionController:reset(hrp)
    self.lastPos = hrp and hrp.Position or nil
    self.lastVelocity = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
    self.lastYaw = hrp and select(2, hrp.CFrame:ToOrientation()) or 0
    self.samples = 0
    self.maxSpeed = 0
    self.maxAcceleration = 0
    self.maxJerk = 0
    self.lastAcceleration = Vector3.zero
    self.sumDt = 0
end

function MotionController:apply(hrp, position, yaw, dt)
    if not hrp then return Vector3.zero end
    dt = math.max(dt or 1/60, 1/240)
    local previousPos = self.lastPos or hrp.Position
    local velocity = (position - previousPos) / dt
    local acceleration = (velocity - self.lastVelocity) / dt
    local jerk = (acceleration - self.lastAcceleration) / dt

    hrp.CFrame = CFrame.new(position) * CFrame.Angles(0, yaw, 0)
    hrp.AssemblyLinearVelocity = velocity

    local speed = velocity.Magnitude
    self.maxSpeed = math.max(self.maxSpeed, speed)
    self.maxAcceleration = math.max(self.maxAcceleration, acceleration.Magnitude)
    self.maxJerk = math.max(self.maxJerk, jerk.Magnitude)
    self.samples += 1
    self.sumDt += dt
    self.lastPos = position
    self.lastVelocity = velocity
    self.lastAcceleration = acceleration
    self.lastYaw = yaw
    return velocity
end

function MotionController:report(prefix)
    return string.format(
        "%s samples=%d avgDt=%.4f maxSpeed=%.2f maxAccel=%.2f maxJerk=%.2f",
        prefix or "[Motion]", self.samples,
        self.samples > 0 and (self.sumDt / self.samples) or 0,
        self.maxSpeed, self.maxAcceleration, self.maxJerk
    )
end

