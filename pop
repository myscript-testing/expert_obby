local function computeFrameMetadata(framesList)
    if not framesList or typeof(framesList) ~= __D("7461626c65") or #framesList == 0 then
        return {}
    end
    
    local meta = table.create(#framesList)
    
    local jumpTimes = {}
    for i, f in ipairs(framesList) do
        if f.j then
            table.insert(jumpTimes, f.t)
        end
    end
    
    local totalFrames = #framesList
    
    for i, f in ipairs(framesList) do
        local minJumpDist = 999
        for _, jt in ipairs(jumpTimes) do
            local d = math.abs(f.t - jt)
            if d < minJumpDist then
                minJumpDist = d
            end
        end
        
        local prevF = framesList[math.max(1, i - 5)]
        local nextF = framesList[math.min(totalFrames, i + 5)]
        local vertDiff = math.max(math.abs(f.c.Y - prevF.c.Y), math.abs(nextF.c.Y - f.c.Y))
        
        local safeFactor = 0
        if not f.j and minJumpDist > 0.85 and vertDiff < 0.25 then
            safeFactor = math.clamp((minJumpDist - 0.85) / 1.15, 0, 1)
        end
        
        local edgeDamp = math.clamp(i / 20, 0, 1) * math.clamp((totalFrames - i) / 20, 0, 1)
        safeFactor = safeFactor * edgeDamp
        
        meta[i] = {
            minJumpDist = minJumpDist,
            vertDiff = vertDiff,
            safeFactor = safeFactor,
            isStrictGround = (not f.j and minJumpDist >= 0.40 and vertDiff < 0.20)
        }
    end
    
    return meta
end

