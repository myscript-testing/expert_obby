                    local playbackRate = math.clamp(
                        horizontalSpeed / WALK_REFERENCE_SPEED,
                        WALK_MIN_PLAYBACK,
                        WALK_MAX_PLAYBACK
                    )
                    walkTrack:AdjustWeight(1.0, 0.06)
                    walkTrack:AdjustSpeed(playbackRate)
                else
                    if jumpTrack.IsPlaying then
                        jumpTrack:Stop(0.12)
                    end
                    if walkTrack.IsPlaying then
                        walkTrack:Stop(0.16)
                    end
                    if not idleTrack.IsPlaying then
                        idleTrack:Play(0.16, 1.0, 1.0)
                    end
                    idleTrack:AdjustWeight(1.0, 0.08)
                end

                updateHumanMouseCamera(exactPos, smoothedFacingYaw + cameraLookLeftAngle, dt, nowClock, isAirborne)
                RunService.Heartbeat:Wait()
                end 
            end

            if walkTrack.IsPlaying then walkTrack:Stop(0.2) end
            if jumpTrack.IsPlaying then jumpTrack:Stop(0.2) end

            local lapDuration = os.clock() - lapStartTime
            if lapDuration > 5 then
                totalLapsCompleted += 1
                cumulativeStats.laps += 1
                cumulativeStats.lapSeconds += lapDuration
                saveSettings()
                lastLapTime = lapDuration
                if bestLapTime == 0 or lapDuration < bestLapTime then
                    local oldPB = bestLapTime
                    bestLapTime = lapDuration
                    triggerPBCelebration(bestLapTime, oldPB)
                end
                if worstLapTime == 0 or lapDuration > worstLapTime then
                    worstLapTime = lapDuration
                end

                if totalLapsCompleted >= AUTO_HOP_AFTER_LAPS and not autoHopInProgress then
                    autoHopInProgress = true
                    runEnabled = true
                    saveSettings()
                    statusLabel.Text = string.format(
                        __D("5374617475733a202564206c617073207265616368656420e2809420686f7070696e67207365727665722e2e2e"),
                        AUTO_HOP_AFTER_LAPS
                    )
                    statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
                    task.defer(performServerHop)
                    break
                end
            end

            if not isPlaying or not isLooping or not isRunningScript then break end
            task.wait(useRandomDelays and (0.35 + math.random() * 0.75) or 0.20)
        end

        stopPlayback()
    end)
end





