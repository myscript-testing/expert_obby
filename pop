    function refreshLists()
        clearList(shopList)
        clearList(inventoryList)
        local groups = inventoryGroups()
        local shopRows, invRows = 0, 0
        for _, shop in ipairs(balloonShop) do
            local group = groups[shop.key]
            local count = group and group.count or 0
            shopRows += 1
            addRow(shopList, group and group.sample or nil, count, count>0, shop, shopRows)
        end
        for key, group in pairs(groups) do
            if not (function()
                for _, shop in ipairs(balloonShop) do if shop.key == key then return true end end
                return false
            end)() then
                invRows += 1
                addRow(inventoryList, group.sample, group.count, true, nil, invRows)
            end
        end
        shopList.CanvasSize = UDim2.new(0,0,0,shopRows*38)
        inventoryList.CanvasSize = UDim2.new(0,0,0,invRows*38)
        modalStatus.Text = "Shop: "..tostring(shopRows).." · Inventory: "..tostring(invRows)
    end

