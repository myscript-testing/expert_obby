-- INTELLIGENT GROUND-FRAME PATHFINDER & HYBRID STEPPER
-- ========================================================

function executeWaypoints(humanoid, waypoints)
    local char = humanoid and humanoid.Parent
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp or not waypoints or #waypoints < 2 then
        return false
    end

    local animScript = char:FindFirstChild("Animate")
    if animScript then animScript.Disabled = false end

    for i = 2, #waypoints do
        if not isPlaying or not isRunningScript then
            return false
        end

        local wp = waypoints[i]
        local wpPos = wp.Position

        if wp.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
            task.wait(randomDelay(0.02, 0.08))
        end

        humanoid:MoveTo(wpPos)

        local reached = false
        local finished = false
        local conn = humanoid.MoveToFinished:Connect(function(didReach)
            finished = true
            reached = (didReach == true)
        end)

        local wpStart = os.clock()
        local timeout = math.clamp((hrp.Position - wpPos).Magnitude / 8, 1.25, 3.0)

        while not finished and isPlaying and isRunningScript do
            local dist = (hrp.Position - wpPos).Magnitude
            if dist <= 2.75 then
                reached = true
                break
            end
            if (os.clock() - wpStart) > timeout then
                break
            end

            statusLabel.Text = "Status: Pathfinding (Native Speed)..."

            local moveDir = wpPos - hrp.Position
            local horiz = Vector3.new(moveDir.X, 0, moveDir.Z)
            if horiz.Magnitude > 0.1 then
                local heading = math.atan2(-horiz.X, -horiz.Z)
                updateHumanMouseCamera(hrp.Position, heading, 0.03, os.clock(), false)
            end

            RunService.Heartbeat:Wait()
        end

        conn:Disconnect()

        if not reached then
            return false
        end
    end

    humanoid:Move(Vector3.zero, false)
    return true
end

function directWalkToTarget(character, humanoid, hrp, targetPos)
    local startT = os.clock()
    local animScript = character:FindFirstChild("Animate")
    if animScript then animScript.Disabled = false end
    
    while isPlaying and isRunningScript do
        if (hrp.Position - targetPos).Magnitude < 2.5 then
            humanoid:Move(Vector3.zero, false)
            return true
        end
        if (os.clock() - startT) > 3.0 then break end
        if humanoid.Health <= 0 or hrp.Position.Y < -30 then break end
        
        local dir = (targetPos - hrp.Position)
        local horizDir = Vector3.new(dir.X, 0, dir.Z)
        if horizDir.Magnitude > 0.1 then
            local moveVec = horizDir.Unit
            humanoid:Move(moveVec, false)
            
            local rayForward = workspace:Raycast(hrp.Position, moveVec * 3.5, cameraRayParams)
            if rayForward and rayForward.Instance and rayForward.Instance.CanCollide then
                humanoid.Jump = true
            end
            
            local heading = math.atan2(-moveVec.X, -moveVec.Z)
            updateHumanMouseCamera(hrp.Position, heading, 0.04, os.clock(), false)
        end
        
        RunService.Heartbeat:Wait()
    end
    
    humanoid:Move(Vector3.zero, false)
    return (hrp.Position - targetPos).Magnitude < 3.5
end

function findAccessibleGroundFrame(currentPos, framesList, metaList)
    local candidates = {}
    
    for idx, frame in ipairs(framesList) do
        local meta = metaList[idx]
        if meta and meta.isStrictGround then
            local dist = (frame.c.Position - currentPos).Magnitude
            table.insert(candidates, {
                idx = idx,
                pos = frame.c.Position,
                dist = dist
            })
        end
    end
    
    table.sort(candidates, function(a, b)
        return a.dist < b.dist
    end)
    
    local scanStartTime = os.clock()
    for _, cand in ipairs(candidates) do
        if not isPlayingRef or not isRunningScriptRef then break end
        if (os.clock() - scanStartTime) >= 2.5 then break end
        
        local testPath = PathfindingService:CreatePath({
            AgentRadius = 1.8,
            AgentHeight = 4.5,
            AgentCanJump = true,
            AgentCanClimb = false,
            WaypointSpacing = 3.0
        })
        
        local success = pcall(function()
            testPath:ComputeAsync(currentPos, cand.pos)
        end)
        
        if success and testPath.Status == Enum.PathStatus.Success then
            local waypoints = testPath:GetWaypoints()
            if #waypoints > 1 then
                return cand.idx, cand.pos, waypoints
            end
        end
    end
    
    return nil, nil, nil
end

function walkToIntelligentTarget(character, humanoid, hrp, targetPosition, trajectoryVariant)
    local startPos = hrp.Position
    local dist = (targetPosition - startPos).Magnitude
    if dist < 2.0 then return true end

    -- Optional trajectory variation for checkpoint routes: instead of always
    -- pathfinding directly to the final target, insert one random intermediate
    -- point around the segment midpoint, then let PathfindingService solve both
    -- legs. This changes the route shape without forcing a specific path.
    if trajectoryVariant then
        local flat = Vector3.new(targetPosition.X - startPos.X, 0, targetPosition.Z - startPos.Z)
        local flatMag = flat.Magnitude
        if flatMag > 8 then
            local dir = flat / flatMag
            local lateral = Vector3.new(-dir.Z, 0, dir.X)
            local midpoint = startPos:Lerp(targetPosition, 0.45 + math.random() * 0.10)
            local offset = math.random(-10, 10)
            local detour = midpoint + lateral * offset

            -- Try a few small, deterministic-in-this-run alternatives; fall back
            -- to the direct route if none of them are reachable.
            local candidates = {
                detour,
                midpoint - lateral * offset,
                midpoint + lateral * (offset * 0.5),
            }
            for _, intermediate in ipairs(candidates) do
                if walkToIntelligentTarget(character, humanoid, hrp, intermediate, false) then
                    if walkToIntelligentTarget(character, humanoid, hrp, targetPosition, false) then
                        return true
                    end
                end
            end
        end
    end
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 1.8,
        AgentHeight = 4.5,
        AgentCanJump = true,
        AgentCanClimb = false,
        WaypointSpacing = 3.0
    })
    
    local success = pcall(function()
        path:ComputeAsync(startPos, targetPosition)
    end)
    
    if success and path.Status == Enum.PathStatus.Success then
        local waypoints = path:GetWaypoints()
        local ok = executeWaypoints(humanoid, waypoints)

        -- Path endpoints can be offset by agent radius / voxelization.
        -- Accept the handoff when the player is close enough to the target,
        -- even if the final MoveTo reports a conservative failure.
        local remaining = (targetPosition - hrp.Position).Magnitude
        if remaining <= 8.0 then
            humanoid:Move(Vector3.zero, false)
            return true
        end

        return ok and remaining <= 4.5
    end
    
    if dist < 45 then
        return directWalkToTarget(character, humanoid, hrp, targetPosition)
    end
    
    return false
end

