function buildKeyframes(baseFrames, route)
    local keyframes = {}
    local count = math.max(6, math.ceil(#baseFrames / 45))

    for k = 1, count do
        local idx = math.floor(1 + (k - 1) * (#baseFrames - 1) / math.max(1, count - 1))
        local seedBase = route.seed or 0
        local extraX = (hashNoise1D(k, 17.1 + seedBase) - 0.5) * 0.07
        local extraZ = (hashNoise1D(k, 31.7 + seedBase) - 0.5) * 0.07
        local extraY = (hashNoise1D(k, 55.3 + seedBase) - 0.5) * 0.012

        keyframes[k] = {
            idx = idx,
            x = route.offset_x + extraX,
            z = route.offset_z + extraZ,
            y = extraY,
        }
    end

    return keyframes
end

function generateRouteVariant(baseFrames, route)
    if not baseFrames or #baseFrames == 0 then return {} end
    if not route then return baseFrames end

    local keyframes = buildKeyframes(baseFrames, route)
    local out = table.create(#baseFrames)
    local k = 1

    for i, baseFrame in ipairs(baseFrames) do
        while k < #keyframes and i > keyframes[k + 1].idx do
            k = k + 1
        end

        local a = keyframes[k]
        local b = keyframes[math.min(#keyframes, k + 1)]
        local span = math.max(1, b.idx - a.idx)
        local t = smoothStep((i - a.idx) / span)

        -- Déplacement latéral relatif à la tangente du parcours, pas en random par frame.
        local p = baseFrame.c.Position
        local prevP = baseFrames[math.max(1, i - 1)].c.Position
        local nextP = baseFrames[math.min(#baseFrames, i + 1)].c.Position
        local tangent = nextP - prevP
        local flat = Vector3.new(tangent.X, 0, tangent.Z)
        local lateral = Vector3.zero
        if flat.Magnitude > 1e-4 then
            flat = flat.Unit
            lateral = Vector3.new(-flat.Z, 0, flat.X)
        end

        local offX = a.x + (b.x - a.x) * t
        local offZ = a.z + (b.z - a.z) * t
        local offY = a.y + (b.y - a.y) * t
        local lateralOffset = offX
        local longitudinalOffset = offZ * 0.15
        local shifted = p + lateral * lateralOffset + flat * longitudinalOffset + Vector3.new(0, offY, 0)

        out[i] = {
            t = baseFrame.t,
            c = CFrame.new(shifted) * (baseFrame.c - baseFrame.c.Position),
            j = baseFrame.j,
        }
    end

    return out
end

function generateTimingProfile(baseFrames, route)
    if not baseFrames or #baseFrames == 0 then return {} end
    if not route then return {} end

    local profile = table.create(#baseFrames)
    local segmentCount = math.max(4, math.ceil(#baseFrames / 70))
    local keys = table.create(segmentCount)
    local seedBase = route.seed or 0

    for i = 1, segmentCount do
        local progress = (i - 1) / math.max(1, segmentCount - 1)
        local natural = math.sin(progress * math.pi)
        local wobble = (hashNoise1D(i, 91.7 + seedBase) - 0.5) * 0.045 * natural
        keys[i] = route.speed_mult * (1 + wobble)
    end

    for i = 1, #baseFrames do
        local u = (i - 1) / math.max(1, #baseFrames - 1) * (segmentCount - 1)
        local aIdx = math.floor(u) + 1
        local bIdx = math.min(segmentCount, aIdx + 1)
        local t = smoothStep(u - math.floor(u))
        profile[i] = keys[aIdx] * (1 - t) + keys[bIdx] * t
    end

    -- Each jump receives a different approach/commit window.  The slowdown
    -- happens before the jump flag, so its real-time offset differs on every
    -- lap without moving a player while airborne or changing the jump arc.
    for i, frame in ipairs(baseFrames) do
        if frame.j then
            local leadFrames = math.random(4, 11)
            local commitScale = randomFloat(0.78, 0.96)
            local first = math.max(1, i - leadFrames)
            for n = first, i do
                local u = (n - first) / math.max(1, i - first)
                local taper = smoothStep(u)
                profile[n] = profile[n] * (1 - (1 - commitScale) * taper)
            end
        end
    end

    return profile
end

function getHumanMicroJitter(nowClock, safetyFactor)
    local s = math.clamp(safetyFactor or 0, 0, 1)
    return Vector3.new(
        math.sin(nowClock * 0.75 + humanJitterState.phaseX) * 0.0009 * s,
        0,
        math.cos(nowClock * 0.95 + humanJitterState.phaseZ) * 0.0009 * s
    )
end

