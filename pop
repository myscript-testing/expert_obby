function simulateHumanError()
    if consecutiveErrors >= maxConsecutiveErrors then return false end
    if math.random(1, 1000) / 1000 < errorChance then
        consecutiveErrors = consecutiveErrors + 1
        return true
    end
    consecutiveErrors = 0
    return false
end

function addPathVariance(pos, amount)
    return pos + Vector3.new((math.random() - 0.5) * amount, 0, (math.random() - 0.5) * amount)
end

function randomDelay(min, max)
    local base = min + (max - min) * math.random()
    local variance = base * 0.18
    return base + (math.random() - 0.5) * variance * 2
end

