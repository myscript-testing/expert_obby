local function sanitizeTimelineFrames(rawFrames)
    if not rawFrames or typeof(rawFrames) ~= __S((57+0)) or #rawFrames == (0+0) then
        return {}
    end
    
    local cleaned = {}
    local timeOffset = (0+0)
    local lastValidT = rawFrames[(1+0)].t
    local lastPos = rawFrames[(1+0)].c.Position
    local staticDuration = (0+0)
    
    for i = (1+0), #rawFrames do
        local f = rawFrames[i]
        local dt = f.t - lastValidT
        local dist = (f.c.Position - lastPos).Magnitude
        
        if dist < (0.035+0) and not f.j then
            staticDuration = staticDuration + dt
            if staticDuration > (0.08+0) then
                timeOffset = timeOffset + (dt * (0.82+0))
            end
        else
            staticDuration = (0+0)
        end
        
        lastValidT = f.t
        lastPos = f.c.Position
        
        local adjustedT = math.max((0+0), f.t - timeOffset)
        table.insert(cleaned, {
            t = adjustedT,
            c = f.c,
            j = f.j
        })
    end
    
    return cleaned
end

