    local function findWheelGui()
        local roots = {}
        local pg = balloonPlayers.LocalPlayer and balloonPlayers.LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pg then roots[#roots+1] = pg end
        roots[#roots+1] = CoreGui
        for _, root in ipairs(roots) do
            for _, d in ipairs(root:GetDescendants()) do
                if d.Name == "RedWheelFrame" and d.Parent then
                    local wheelGui = d.Parent
                    local mainFrame = wheelGui:FindFirstChild("MainFrame")
                    if mainFrame and mainFrame:FindFirstChild("ScrollingFrame") then
                        return wheelGui, mainFrame
                    end
                end
            end
        end
        return nil, nil
    end

    local function selectNativeBalloon(shop, amount)
        amount = math.clamp(tonumber(amount) or 1, 1, 2)
        local wheelGui, mainFrame = findWheelGui()
        if not wheelGui or not mainFrame then
            return nil, nil, "Native wheel UI unavailable"
        end

        local scroller = mainFrame:FindFirstChild("ScrollingFrame")
        if not scroller then
            return nil, nil, "Wheel selector unavailable"
        end

        local selector = scroller:FindFirstChild(tostring(shop.index), true)
        local selectorButton = nil
        if selector and selector:IsA("GuiButton") then
            selectorButton = selector
        elseif selector then
            selectorButton = selector:FindFirstChildWhichIsA("GuiButton", true)
        end

        if selectorButton then
            pcall(function() selectorButton:Activate() end)
            task.wait(0.05)
        end

        local frameName = amount == 2 and "RedWheelFrame2" or "RedWheelFrame"
        local openFrame = wheelGui:FindFirstChild(frameName)
        if not openFrame then
            return nil, nil, frameName .. " unavailable"
        end

        local openName = amount == 2 and "2Open" or "1Open"
        local openButton = openFrame:FindFirstChild(openName, true)
        if openButton and openButton:IsA("GuiButton") then
            pcall(function() openButton:Activate() end)
            task.wait(0.03)
        end

        local opts = openFrame:FindFirstChild("OptionsFrame", true)
        if not opts then
            return nil, nil, "OptionsFrame unavailable"
        end
        return openFrame, opts, nil
    end

    local function nativeShopOpen(shop, amount)
        local openFrame, opts, err = selectNativeBalloon(shop, amount)
        if not openFrame then return false, err end

        local buy = opts:FindFirstChild("BuyButton", true)
        if not buy or not buy:IsA("GuiButton") then
            return false, "BuyButton unavailable"
        end

        local ready = false
        local deadline = os.clock() + 1.5
        while os.clock() < deadline do
            if buy.Active ~= false then
                ready = true
                break
            end
            task.wait()
        end
        if not ready then return false, "BuyButton locked" end

        local ok, errMsg = pcall(function() buy:Activate() end)
        if not ok then
            return false, "BuyButton activation failed: " .. tostring(errMsg)
        end
        return true, "Native shop purchase requested"
    end

    local function nativeAutoBuy(shop, amount)
        amount = math.clamp(tonumber(amount) or 1, 1, 2)

        if not shop then
            return false, "Missing shop balloon"
        end
        if shop.currency == "Robux" then
            return false, "Native auto-buy is disabled for Robux balloons"
        end

        -- Use the same proven Credits request as BUY 1/2.
        -- Do not depend on the native ScrollingFrame selection (which can
        -- point at an unrelated child such as balloon 5).
        refreshBalloonRemotes()
        local spinRemote = balloonSpinRemote
        local completeRemote = balloonCompleteSpinRemote
        if not spinRemote or not spinRemote:IsA("RemoteFunction") then
            return false, "SpinBalloon remote unavailable"
        end

        local ok, result = pcall(function()
            return spinRemote:InvokeServer(tonumber(shop.index) or 1, amount, false)
        end)

        if not ok then
            return false, "Auto buy request failed: " .. tostring(result)
        end
        if type(result) ~= "table" then
            return false, "Auto buy returned an invalid response"
        end
        if result.success == false then
            return false, tostring(result.reason or "purchase rejected")
        end

        if result.spinId and completeRemote then
            task.spawn(function()
                for attempt = 1, 3 do
                    local doneOk, doneResult = pcall(function()
                        if completeRemote:IsA("RemoteFunction") then
                            return completeRemote:InvokeServer(result.spinId)
                        elseif completeRemote:IsA("RemoteEvent") then
                            completeRemote:FireServer(result.spinId)
                            return true
                        end
                        return false
                    end)
                    if doneOk and doneResult ~= false then break end
                    task.wait(0.15 * attempt)
                end
            end)
        end

        return true, amount == 2 and "Auto BUY 2 requested" or "Auto BUY 1 requested"
    end

    local function resolveBalloonRemotes()
        local rs = balloonReplicatedStorage
        local folder = rs:FindFirstChild("InfinitePackRemotesV2")
        local getRewards = folder and folder:FindFirstChild("GetBalloonRewards")
        local redeem = folder and folder:FindFirstChild("RedeemBalloonReward")
        local spin = rs:FindFirstChild("SpinBalloon")
        local completeSpin = rs:FindFirstChild("CompleteSpinBalloon")
        local devProduct = rs:FindFirstChild("RequestDevProductPrompt")
        return getRewards, redeem, spin, completeSpin, devProduct
    end

    local function completeBalloonSpin(completeRemote, spinId)
        if not completeRemote or not spinId then return false end
        for attempt = 1, 3 do
            local ok, result = pcall(function()
                if completeRemote:IsA("RemoteFunction") then
                    return completeRemote:InvokeServer(spinId)
                elseif completeRemote:IsA("RemoteEvent") then
                    completeRemote:FireServer(spinId)
                    return true
                end
                return false
            end)
            if ok and result ~= false then return true end
            task.wait(0.15 * attempt)
        end
        return false
    end

    local function shopOpen(shop, amount)
        amount = math.clamp(tonumber(amount) or 1, 1, 2)
        if not shop then
            return false, "Missing shop balloon"
        end

        local _, _, spinRemote, completeRemote, devProductRemote = resolveBalloonRemotes()

        -- Robux purchases must go through the game's normal purchase prompt.
        if shop.currency == "Robux" and type(shop.productIds) == "table" then
            local productId = shop.productIds[amount]
            if productId and devProductRemote and devProductRemote:IsA("RemoteEvent") then
                local ok, err = pcall(function()
                    devProductRemote:FireServer(productId)
                end)
                if ok then return true, "Purchase prompt requested" end
                return false, tostring(err or "Robux prompt failed")
            end
            return false, "Robux product unavailable"
        end

        -- Credits: prefer the native wheel path, then fall back to the server remote.
        local nativeOk, nativeMsg = nativeShopOpen(shop, amount)
        if nativeOk then
            return true, nativeMsg
        end

        if spinRemote and spinRemote:IsA("RemoteFunction") then
            local ok, result = pcall(function()
                return spinRemote:InvokeServer(tonumber(shop.index) or 1, amount, false)
            end)
            if ok and type(result) == "table" and result.success ~= false then
                if result.spinId and completeRemote then
                    task.spawn(function() completeBalloonSpin(completeRemote, result.spinId) end)
                end
                return true, amount == 2 and "Opened x2 with Credits" or "Opened x1 with Credits"
            end
            if not ok then
                return false, "Spin request failed: " .. tostring(result) .. " | " .. tostring(nativeMsg)
            end
            return false, tostring(result.reason or "purchase rejected") .. " | " .. tostring(nativeMsg)
        end

        return false, nativeMsg or "Credit spin unavailable"
    end

    local function openOne(item, callback)
        if type(item) ~= "table" or not item.id then
            if callback then callback(false,"missing_id") end
            return
        end
        if balloonBusy then
            if callback then callback(false,"busy") end
            return
        end
        balloonBusy = true
        local wheel = _G.WheelGiftSystem
        if wheel and type(wheel.openGiftBalloon) == "function" then
            local finished = false
            local ok = pcall(function()
                return wheel.openGiftBalloon(item.id, tonumber(item.balloonIndex) or 2, function(success, reason)
                    finished = true
                    balloonBusy = false
                    if callback then callback(success, reason) end
                end)
            end)
            if not finished then
                task.delay(1.5, function()
                    if balloonBusy then
                        balloonBusy = false
                        if callback then callback(false, ok and "timeout" or "wheel_error") end
                    end
                end)
            end
            return
        end
        if not balloonRedeemRemote or not balloonRedeemRemote:IsA("RemoteFunction") then
            balloonBusy = false
            if callback then callback(false,"RedeemBalloonReward unavailable") end
            return
        end
        local ok, result = pcall(function() return balloonRedeemRemote:InvokeServer(item.id) end)
        balloonBusy = false
        local success = ok and type(result)=="table" and result.success==true
        if callback then callback(success, success and nil or (type(result)=="table" and result.reason or "redeem_failed")) end
    end

