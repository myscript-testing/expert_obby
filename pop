function attachInteractiveEffects(btn)
    -- Ne stocke pas la taille une seule fois au chargement : le skin du GUI
    -- peut redimensionner les boutons plus tard. On mémorise donc la taille
    -- réellement utilisée au moment de l'appui.
    local pressedBaseSize = nil
    
    local function restoreButtonSize()
        if pressedBaseSize then
            TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = pressedBaseSize
            }):Play()
            pressedBaseSize = nil
        end
    end
    
    btn.MouseEnter:Connect(function()
        local hoverColor = btn.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.16)
        TweenService:Create(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverColor
        }):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = btn.BackgroundColor3
        }):Play()
        restoreButtonSize()
    end)
    
    btn.MouseButton1Down:Connect(function()
        pressedBaseSize = btn.Size
        -- Réduit aussi les offsets négatifs : cela évite l'effet
        -- "le bouton s'allonge" sur les boutons en UDim2 plein écran.
        local pressedSize = UDim2.new(
            pressedBaseSize.X.Scale * 0.985,
            pressedBaseSize.X.Offset * 0.985,
            pressedBaseSize.Y.Scale * 0.92,
            pressedBaseSize.Y.Offset * 0.92
        )
        TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = pressedSize
        }):Play()
    end)
    
    btn.MouseButton1Up:Connect(function()
        restoreButtonSize()
    end)
end

