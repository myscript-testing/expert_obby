    local acDraggingSlider = false
    local function acSetCps(value)
        local n = tonumber(value)
        if not n then n = acConfig.cps end
        acConfig.cps = math.clamp(math.floor(n + 0.5),1,30)
        local prog = (acConfig.cps - 1) / 29
        acCps.Text = tostring(acConfig.cps)
        acFill.Size = UDim2.new(prog,0,1,0)
        acKnob.Position = UDim2.new(prog,0,0.5,0)
    end
    local function acSetCpsFromX(x)
        local w = acSlider.AbsoluteSize.X
        if w <= 0 then return end
        local ratio = math.clamp((x-acSlider.AbsolutePosition.X)/w,0,1)
        acSetCps(1 + math.floor(ratio*29 + 0.5))
    end
    acCps.FocusLost:Connect(function() acSetCps(acCps.Text) end)
    acSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            acDraggingSlider=true
            acSetCpsFromX(input.Position.X)
        end
    end)
    acSlider.InputChanged:Connect(function(input)
        if acDraggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            acSetCpsFromX(input.Position.X)
        end
    end)
    acUIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then acDraggingSlider=false end
    end)

    local function acFinishSelection(p)
        local s = acConfig.start
        if not s then return end
        local left,right = math.min(s.X,p.X),math.max(s.X,p.X)
        local top,bottom = math.min(s.Y,p.Y),math.max(s.Y,p.Y)
        if right-left >= 8 and bottom-top >= 8 then
            acConfig.zone={left=left,top=top,right=right,bottom=bottom}
            acSelection.Position=UDim2.fromOffset(left,top)
            acSelection.Size=UDim2.fromOffset(right-left,bottom-top)
            acSelection.Visible=true
            acInfo.Text=string.format("Sélection : %d × %d px",right-left,bottom-top)
            acStatus.Text="Zone prête"
        else
            acSelection.Visible=false
            acStatus.Text="Zone trop petite — recommencez"
        end
        acConfig.selecting=false
        acConfig.start=nil
        acSelector.Visible=false
        acInstruction.Visible=false
    end
    acSelect.MouseButton1Click:Connect(function()
        acConfig.enabled=false
        acToggle.Text="DÉMARRER L'AUTOCLICKER"
        acToggle.BackgroundColor3=Color3.fromRGB(51,57,76)
        acConfig.selecting=true
        acConfig.start=nil
        acSelector.Visible=true
        acInstruction.Visible=true
        acSelection.Visible=false
        acStatus.Text="Mode sélection actif"
    end)
    acSelector.InputBegan:Connect(function(input)
        if acConfig.selecting and input.UserInputType == Enum.UserInputType.MouseButton1 then
            acConfig.start=input.Position
            acSelection.Position=UDim2.fromOffset(input.Position.X,input.Position.Y)
            acSelection.Size=UDim2.fromOffset(1,1)
            acSelection.Visible=true
        end
    end)
    acSelector.InputChanged:Connect(function(input)
        if acConfig.selecting and acConfig.start and input.UserInputType == Enum.UserInputType.MouseMovement then
            local p=input.Position
            local s=acConfig.start
            local left,top=math.min(s.X,p.X),math.min(s.Y,p.Y)
            acSelection.Position=UDim2.fromOffset(left,top)
            acSelection.Size=UDim2.fromOffset(math.abs(p.X-s.X),math.abs(p.Y-s.Y))
        end
    end)
    acSelector.InputEnded:Connect(function(input)
        if acConfig.selecting and acConfig.start and input.UserInputType == Enum.UserInputType.MouseButton1 then
            acFinishSelection(input.Position)
        end
    end)
    acToggle.MouseButton1Click:Connect(function()
        if not acConfig.zone then acStatus.Text="Choisissez d'abord une zone"; return end
        acConfig.enabled=not acConfig.enabled
        if acConfig.enabled then
            acToggle.Text="ARRÊTER L'AUTOCLICKER"
            acToggle.BackgroundColor3=Color3.fromRGB(255,96,111)
            acStatus.Text="Autoclicker actif"
        else
            acToggle.Text="DÉMARRER L'AUTOCLICKER"
            acToggle.BackgroundColor3=Color3.fromRGB(51,57,76)
            acStatus.Text="Zone prête"
        end
    end)
    acSetCps(12)
    task.spawn(function()
        while isRunningScript and screenGui.Parent do
            if acConfig.enabled and acConfig.zone and not acConfig.selecting then
                local z=acConfig.zone
                local x=math.random(z.left+2,math.max(z.left+2,z.right-2))
                local y=math.random(z.top+2,math.max(z.top+2,z.bottom-2))
                pcall(function()
                    acVIM:SendMouseMoveEvent(x,y,game)
                    acVIM:SendMouseButtonEvent(x,y,0,true,game,0)
                end)
                task.wait(math.max(0.001,0.5/acConfig.cps))
                pcall(function() acVIM:SendMouseButtonEvent(x,y,0,false,game,0) end)
                task.wait(math.max(0.001,1/acConfig.cps))
            else
                task.wait(0.05)
            end
        end
    end)
end

