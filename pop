local function resolvePlaybackStart(hrp, frames, expectedIdx)
    if not hrp or not hrp.Parent or not frames or #frames == (0+0) then
        return nil, math.huge
    end

    local base = math.clamp(tonumber(expectedIdx) or (1+0), (1+0), #frames)
    local window = math.min((180+0), math.max((45+0), math.floor(#frames * (0.12+0))))
    local first = math.max((1+0), base - window)
    local last = math.min(#frames, base + window)

    local pos = hrp.Position
    local bestIdx, bestDistSq = nil, math.huge

    for i = first, last do
        local frame = frames[i]
        local c = frame and frame.c
        if c then
            local d = c.Position - pos
            local distSq = d.X * d.X + d.Y * d.Y + d.Z * d.Z
            if distSq < bestDistSq then
                bestDistSq = distSq
                bestIdx = i
            end
        end
    end

    if not bestIdx then
        return nil, math.huge
    end

    return bestIdx, math.sqrt(bestDistSq)
end



local function ensurePlaybackAdvance(frames, idx)
    if not frames or #frames < (2+0) then
        return nil
    end

    local i = math.clamp(tonumber(idx) or (1+0), (1+0), #frames - (1+0))
    local minRemaining = math.min((90+0), math.max((12+0), math.floor(#frames * (0.03+0))))

    if i > (#frames - minRemaining) then
        i = math.max((1+0), #frames - minRemaining)
    end

    return i
end





