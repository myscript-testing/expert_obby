    local function runSelectedAction(amount, automatic)
        if not balloonSelected then
            modalStatus.Text = "Select a balloon first."
            return
        end

        if balloonSelected.shop then
            if automatic then
                local slot = (amount == 1) and "one" or "two"
                if balloonAuto[slot] then
                    stopAuto(slot)
                    modalStatus.Text = "Auto " .. tostring(amount) .. " OFF"
                    return
                end
                stopAuto(slot)
                balloonAuto[slot] = true
                balloonAuto[slot .. "Thread"] = task.spawn(function()
                    while balloonAuto[slot] do
                        local ok, msg = nativeAutoBuy(balloonSelected.shop, amount)
                        modalStatus.Text = ok and ("Auto: " .. tostring(msg)) or ("Auto failed: " .. tostring(msg))
                        if not ok then
                            break
                        end
                        if not balloonSelected or not balloonSelected.shop then
                            break
                        end
                        task.wait(0.65)
                        fetchInventory()
                        refreshLists()
                    end
                    balloonAuto[slot] = false
                    balloonAuto[slot .. "Thread"] = nil
                    updateMainActionButtons()
                end)
                updateMainActionButtons()
                return
            end

            local ok, msg = shopOpen(balloonSelected.shop, amount)
            modalStatus.Text = ok and tostring(msg) or ("Purchase failed: " .. tostring(msg))
            if ok then
                task.wait(0.35)
                fetchInventory()
                refreshLists()
            end
            return
        end

        if balloonSelected.owned then
            if automatic then
                local slot = (amount == 1) and "one" or "two"
                if balloonAuto[slot] then
                    stopAuto(slot)
                    modalStatus.Text = "Auto " .. tostring(amount) .. " OFF"
                    return
                end
                stopAuto(slot)
                balloonAuto[slot] = true
                balloonAuto[slot .. "Thread"] = task.spawn(function()
                    while balloonAuto[slot] do
                        local items = selectedItems()
                        local take = math.min(amount, #items)
                        if take <= 0 then
                            modalStatus.Text = "Inventory empty for selected balloon."
                            break
                        end
                        for i = 1, take do
                            if not balloonAuto[slot] then break end
                            local done, success, reason = false, false, nil
                            openOne(items[i], function(ok, why)
                                done = true
                                success = ok == true
                                reason = why
                            end)
                            local deadline = os.clock() + 2.5
                            while not done and os.clock() < deadline and balloonAuto[slot] do
                                task.wait(0.05)
                            end
                            if not done or not success then
                                modalStatus.Text = "Auto open failed: " .. tostring(reason or "timeout")
                                balloonAuto[slot] = false
                                break
                            end
                            task.wait(0.25)
                        end
                        fetchInventory()
                        refreshLists()
                        task.wait(1.0)
                    end
                    balloonAuto[slot] = false
                    balloonAuto[slot .. "Thread"] = nil
                    updateMainActionButtons()
                end)
                updateMainActionButtons()
                return
            end

            openInventoryCount(amount)
            return
        end

        modalStatus.Text = "Select a balloon first."
    end

