    local function openInventoryCount(count)
        local items = selectedItems()
        local amount = math.min(tonumber(count) or 1, #items)
        if amount <= 0 then modalStatus.Text = "No balloons of this type in inventory."; return end
        local i = 1
        local function step()
            if i > amount then
                fetchInventory(); refreshLists()
                return
            end
            modalStatus.Text = "Opening "..tostring(i).."/"..tostring(amount).."..."
            openOne(items[i], function(success, reason)
                if not success then modalStatus.Text = "Open failed: "..tostring(reason or "unknown"); return end
                i += 1
                task.wait(0.12)
                step()
            end)
        end
        step()
    end

