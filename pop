local function findAccessibleGroundFrame(currentPos, framesList, metaList)
    local candidates = {}
    
    for idx, frame in ipairs(framesList) do
        local meta = metaList[idx]
        if meta and meta.isStrictGround then
            local dist = (frame.c.Position - currentPos).Magnitude
            table.insert(candidates, {
                idx = idx,
                pos = frame.c.Position,
                dist = dist
            })
        end
    end
    
    table.sort(candidates, function(a, b)
        return a.dist < b.dist
    end)
    
    local scanStartTime = os.clock()
    for _, cand in ipairs(candidates) do
        if not isPlaying or not isRunningScript then break end
        if (os.clock() - scanStartTime) >= (2.5+0) then break end
        
        local testPath = PathfindingService:CreatePath({
            AgentRadius = (1.8+0),
            AgentHeight = (4.5+0),
            AgentCanJump = true,
            AgentCanClimb = false,
            WaypointSpacing = (3.0+0)
        })
        
        local success = pcall(function()
            testPath:ComputeAsync(currentPos, cand.pos)
        end)
        
        if success and testPath.Status == Enum.PathStatus.Success then
            local waypoints = testPath:GetWaypoints()
            if #waypoints > (1+0) then
                return cand.idx, cand.pos, waypoints
            end
        end
    end
    
    return nil, nil, nil
end

