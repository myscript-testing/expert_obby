-- NEW: REWIND TO JUMP PEAK AND DROP (WITHOUT TP)
-- ========================================================

function smoothVoidDrop(character, humanoid, hrp, dropDuration)
    dropDuration = dropDuration or 1.8

    statusLabel.Text = "Status: Falling to void..."
    statusLabel.TextColor3 = Color3.fromRGB(230, 126, 34)

    local startPos = hrp.Position
    local startVelocity = hrp.AssemblyLinearVelocity
    local startYaw = select(2, hrp.CFrame:ToOrientation())
    local startTime = os.clock()
    local lastPos = startPos
    local fallenPartsY = tonumber(workspace.FallenPartsDestroyHeight) or -500
    -- Descend past Roblox's destruction threshold rather than a fixed distance.
    -- A high checkpoint or a lower platform can therefore never catch the player.
    local voidTargetY = fallenPartsY - 10
    local totalFallDistance = math.max(80, startPos.Y - voidTargetY)

    -- Même logique que le playback normal : interpolation à chaque Heartbeat,
    -- puis calcul d'une vraie vitesse depuis la position précédente.
    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)

    while isPlaying and isRunningScript and humanoid.Health > 0 do
        local elapsed = os.clock() - startTime
        local alpha = math.clamp(elapsed / dropDuration, 0, 1)

        -- Courbe douce : départ progressif, puis accélération naturelle vers le vide.
        local smoothAlpha = alpha * alpha * (3 - 2 * alpha)
        local fallDistance = totalFallDistance * smoothAlpha

        local horizontalFactor = 1 - (0.82 * smoothAlpha)
        local horizontal = Vector3.new(startVelocity.X, 0, startVelocity.Z) * horizontalFactor
        local targetPos = startPos
            + Vector3.new(horizontal.X * elapsed, -fallDistance, horizontal.Z * elapsed)

        -- Petit amortissement pour éviter un mouvement parfaitement mécanique.
        local exactPos = lastPos:Lerp(targetPos, 0.72)
        -- Avoid ending a last interpolation step just above the void threshold.
        if alpha >= 1 then
            exactPos = Vector3.new(exactPos.X, voidTargetY, exactPos.Z)
        end
        -- Vitesse dérivée de la même courbe pour garder un mouvement fluide.
        local curveSpeed = -(totalFallDistance / dropDuration) * (6 * alpha * (1 - alpha))
        local realVelocity = Vector3.new(horizontal.X, curveSpeed, horizontal.Z)

        if activeMotionController then
            realVelocity = activeMotionController:apply(hrp, exactPos, startYaw, 1/60)
        else
            hrp.CFrame = CFrame.new(exactPos) * CFrame.Angles(0, startYaw, 0)
            hrp.AssemblyLinearVelocity = realVelocity
        end
        lastPos = exactPos

        updateHumanMouseCamera(exactPos, startYaw, 0.03, os.clock(), false)

        if humanoid.Health <= 0 or exactPos.Y <= voidTargetY or alpha >= 1 then
            break
        end

        RunService.Heartbeat:Wait()
    end

    -- On laisse exactement 1.5 s avant de reprendre la boucle / attendre le respawn.
    task.wait(1.5)
end

-- Human-mistake path: stop the replay and let Roblox physics/game logic handle
-- the missed jump. The game itself sends the player back to spawn; no forced
-- CFrame descent or artificial death is used here.
function releaseForHumanMistake(humanoid, hrp)
    local releasePos = hrp.Position
    humanoid:Move(Vector3.zero, false)
    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    hrp.AssemblyLinearVelocity = Vector3.new(0, math.min(hrp.AssemblyLinearVelocity.Y, 0), 0)

    local deadline = os.clock() + 12
    while isPlaying and isRunningScript and humanoid.Health > 0 and os.clock() < deadline do
        local movedFromRelease = (hrp.Position - releasePos).Magnitude
        if movedFromRelease >= SPAWN_RESET_DISTANCE or hrp.Position.Y < -40 then
            diagnosticReason = "Game reset to spawn after Human Mistake"
            return true
        end
        RunService.Heartbeat:Wait()
    end

    diagnosticReason = "Human Mistake release timeout"
    return false
end

function rewindToJumpPeakAndDrop(
    character, humanoid, hrp, targetPeakIdx,
    statusLabelRef, activeFramesRef,
    isPlayingRef, isRunningScriptRef,
    updateCameraRef, runServiceRef, cameraRayParamsRef, smoothVoidDropRef
)
    statusLabelRef.Text = "Status: Returning to jump peak..."
    statusLabelRef.TextColor3 = Color3.fromRGB(230, 126, 34)

    -- Trouve la frame de la timeline la plus proche de la position actuelle.
    local currentIdx = 1
    local minDist = math.huge
    for idx, frame in ipairs(activeFramesRef) do
        local d = (frame.c.Position - hrp.Position).Magnitude
        if d < minDist then
            minDist = d
            currentIdx = idx
        end
    end

    if targetPeakIdx > currentIdx then targetPeakIdx = currentIdx end
    if targetPeakIdx < 1 then targetPeakIdx = 1 end

    local startPos = hrp.Position
    local startYaw = select(2, hrp.CFrame:ToOrientation())
    local lastPos = startPos
    local totalFrames = math.max(currentIdx - targetPeakIdx, 1)

    -- Recul fluide vers le sommet du saut, sans téléportation brutale.
    for idx = currentIdx, targetPeakIdx, -1 do
        if not isPlaying or not isRunningScript then break end

        local progress = (currentIdx - idx) / totalFrames
        local eased = progress * progress * (3 - 2 * progress)
        local targetPos = activeFramesRef[idx].c.Position
        local blendedTarget = startPos:Lerp(targetPos, eased)
        local newPos = lastPos:Lerp(blendedTarget, 0.55)
        local dt = math.max(1 / 60, 0.001)

        hrp.CFrame = CFrame.new(newPos) * CFrame.Angles(0, startYaw, 0)
        hrp.AssemblyLinearVelocity = (newPos - lastPos) / dt
        lastPos = newPos

        updateCameraRef(newPos, startYaw, 0.03, os.clock(), false)
        runServiceRef.Heartbeat:Wait()
    end

    -- Si un sol est réellement présent sous le personnage, on évite de forcer le vide.
    local rayOrigin = hrp.Position + Vector3.new(0, -2, 0)
    local rayDirection = Vector3.new(0, -100, 0)
    local rayResult = workspace:Raycast(rayOrigin, rayDirection, cameraRayParamsRef)

    if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
        statusLabelRef.Text = "Status: Ground detected below, aborting drop."
        statusLabelRef.TextColor3 = Color3.fromRGB(241, 196, 15)
        task.wait(1.5)
        return
    end

    smoothVoidDropRef(character, humanoid, hrp, 1.5)
end

