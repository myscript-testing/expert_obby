-- SILKY-SMOOTH HEARTBEAT-INTERPOLATED PLAYBACK ENGINE
-- ========================================================

function waitForReadyCharacter(timeoutSeconds)
    local deadline = os.clock() + (timeoutSeconds or 30)
    repeat
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if character and character.Parent and humanoid and hrp and humanoid.Health > 0 then
            return character, humanoid, hrp
        end
        task.wait(0.25)
    until not isRunningScript or os.clock() >= deadline
    return nil, nil, nil
end

local function runCheckpointRoute(character, humanoid, hrp, definition, routeName)
    local checkpoints = definition and definition.checkpoints or {}
    if #checkpoints == 0 then
        statusLabel.Text = string.format("Status: %s - no checkpoints", routeName)
        statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
        return false
    end

    local originalWalkSpeed = humanoid.WalkSpeed
    local speedMin = tonumber(definition.speedMin) or 26
    local speedMax = tonumber(definition.speedMax) or 34
    local checkpointRadius = math.max(0, tonumber(definition.checkpointRadius) or 2)

    for index, target in ipairs(checkpoints) do
        if not isPlaying or not isRunningScript then
            pcall(function() humanoid.WalkSpeed = originalWalkSpeed end)
            return false
        end

        -- Vary only the movement speed for this checkpoint segment;
        -- the chosen path itself is still whatever PathfindingService resolves.
        local segmentSpeed = math.random(math.floor(speedMin * 10), math.floor(speedMax * 10)) / 10
        pcall(function() humanoid.WalkSpeed = segmentSpeed end)

        local angle = math.random() * math.pi * 2
        local radius = checkpointRadius * math.sqrt(math.random())
        local approachTarget = target + Vector3.new(
            math.cos(angle) * radius,
            0,
            math.sin(angle) * radius
        )

        statusLabel.Text = string.format(
            "Status: %s - Pathfinder checkpoint %d/%d (%.1f speed, %.2f studs)",
            routeName, index, #checkpoints, segmentSpeed, radius
        )
        statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)

        local ok = walkToIntelligentTarget(character, humanoid, hrp, approachTarget, true)
        if not ok then
            pcall(function() humanoid.WalkSpeed = originalWalkSpeed end)
            statusLabel.Text = string.format("Status: %s - checkpoint %d failed", routeName, index)
            statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
            return false
        end

        task.wait(0.10)
    end

    pcall(function() humanoid.WalkSpeed = originalWalkSpeed end)
    statusLabel.Text = string.format("Status: %s - all checkpoints reached", routeName)
    statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
    return true
end

function startPlayback()
    if isPlaying or not isRunningScript then return end
    local selectedDefinitionForStart = getSelectedObbyDefinition()
    if not selectedDefinitionForStart.pathfinderOnly and (not activeTimelineFrames or #activeTimelineFrames == 0) then
        warn("[AutoObby] No recorded frames found in script or environment!")
        statusLabel.Text = "Status: No Frames Found!"
        statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
        return
    end

    isPlaying = true
    statusLabel.Text = "Status: Pre-computing route variants..."
    statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
    toggleButton.Text = "⏹ Disable Run"
    TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(231, 76, 60)}):Play()
    restoreBarBtn.Text = "⚡ Running [ + ]"
    playbackRunNumber = 1
    local selectedDefinition = getSelectedObbyDefinition()
    refreshActiveTimeline(selectedDefinition.primary)

    playbackThread = task.spawn(function()
        while isPlaying and isRunningScript do
            selectedDefinition = getSelectedObbyDefinition()
            waitForSafetyPause()
            if not isPlaying or not isRunningScript then break end

            if selectedDefinition.pathfinderOnly then
                playbackRunNumber = 1
                local character, humanoid, hrp = waitForReadyCharacter(30)
                if not character then
                    statusLabel.Text = "Status: Waiting for character..."
                    task.wait(1)
                    continue
                end

                isPlaying = true
                restoreBarBtn.Text = string.format("⚡ %s Running [ + ]", selectedObby)
                local completed = runCheckpointRoute(character, humanoid, hrp, selectedDefinition, selectedObby)

                if not isPlaying or not isRunningScript then
                    break
                end

                if completed and isLooping then
                    statusLabel.Text = string.format("Status: %s complete - restarting...", selectedObby)
                    statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
                    task.wait(useRandomDelays and (0.35 + math.random() * 0.75) or 0.20)
                    continue
                end

                break
            end

            if playbackRunNumber == 2 and selectedDefinition.secondary then
                refreshActiveTimeline(selectedDefinition.secondary)
            else
                playbackRunNumber = 1
                refreshActiveTimeline(selectedDefinition.primary)
            end

            local character, humanoid, hrp = waitForReadyCharacter(30)
            if not character then
                warn("[AutoResume] Character was not ready after 30 seconds; retrying.")
                statusLabel.Text = "Status: Waiting for character..."
                task.wait(1)
                continue
            end

            local selectedRouteConfig, routeName = selectRandomRoute()
            local routeConfig = selectedRouteConfig
            -- Both runs use the existing route-mode system.
            -- Run 2 keeps the imported TAS as its base frame timeline, then
            -- applies the selected route profile just like Run 1.
            local variantFrames = generateRouteVariant(activeTimelineFrames, routeConfig)
            local timingProfile = generateTimingProfile(activeTimelineFrames, routeConfig)
            humanJitterState.phaseX = routeConfig.jitter_phase_x
            humanJitterState.phaseZ = routeConfig.jitter_phase_z
            generateHumanCameraProfile()

            local _, startYaw = hrp.CFrame:ToOrientation()
            camYaw = startYaw
            camVelocityYaw = 0

            local animateScript = character:FindFirstChild("Animate")
            if animateScript then animateScript.Disabled = false end

            local checkpointTarget = selectedDefinition.checkpointTarget
            local defaultStartIdx = 1
            for idx, frame in ipairs(variantFrames) do
                if frame.t >= selectedDefinition.handoffT then
                    defaultStartIdx = idx
                    break
                end
            end

            local startFrameIdx = defaultStartIdx
            local pathResolved = false
            while isPlaying and not pathResolved and isRunningScript do
                character, humanoid, hrp = waitForReadyCharacter(30)
                if not character then
                    statusLabel.Text = "Status: Waiting for character..."
                    task.wait(1)
                    continue
                end

                statusLabel.Text = "Status: Pathfinding to Checkpoint..."
                statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
                local pathSuccess = walkToIntelligentTarget(character, humanoid, hrp, checkpointTarget)

                if pathSuccess then
                    local syncedIdx, syncDist = resolvePlaybackStart(hrp, variantFrames, defaultStartIdx)
                    startFrameIdx = syncedIdx or defaultStartIdx
                    statusLabel.Text = string.format("Status: Handoff synced (frame %d, %.1f studs)...",
                        startFrameIdx, syncDist or 0)
                    pathResolved = true
                    break
                end

                if isPlaying and isRunningScript then
                    statusLabel.Text = "Status: Scanning Ground Frames..."
                    statusLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
                    local foundIdx, _, foundWaypoints = findAccessibleGroundFrame(hrp.Position, variantFrames, frameMetadata)
                    if foundIdx and foundWaypoints then
                        local waypointOk = executeWaypoints(humanoid, foundWaypoints)
                        task.wait()
                        local syncedIdx, syncDist = resolvePlaybackStart(hrp, variantFrames, foundIdx)
                        local arrived = false
                        if syncDist and syncDist <= 14 then
                            arrived = true
                        elseif waypointOk ~= false then
                            arrived = true
                        end

                        if arrived and syncedIdx then
                            startFrameIdx = syncedIdx
                            statusLabel.Text = string.format(
                                "Status: Handoff synced (frame %d, %.1f studs)...",
                                startFrameIdx, syncDist or 0
                            )
                            pathResolved = true
                            break
                        end
                    end

                    local lastJumpPeakIdx = nil
                    for jumpNum = jumpCounter, 1, -1 do
                        if jumpPeakData[jumpNum] then
                            lastJumpPeakIdx = jumpPeakData[jumpNum].peakIdx
                            break
                        end
                    end
                    if lastJumpPeakIdx then
                        rewindToJumpPeakAndDrop(
                            character, humanoid, hrp, lastJumpPeakIdx,
                            statusLabel, activeTimelineFrames,
                            isPlaying, isRunningScript,
                            updateHumanMouseCamera, RunService, cameraRayParams, smoothVoidDrop
                        )
                    else
                        smoothVoidDrop(character, humanoid, hrp, 1.5)
                    end
                    break
                end
            end

            if not isPlaying or not isRunningScript then
                if animateScript then animateScript.Disabled = false end
                resetCameraToNative()
                break
            end

            if animateScript then animateScript.Disabled = true end
            local idleTrack, walkTrack, jumpTrack = setupCharacterAnimations(character, humanoid)
            activeIdleTrack, activeWalkTrack, activeJumpTrack = idleTrack, walkTrack, jumpTrack

            local runLabel = routeConfig.name
            local totalRuns = selectedDefinition.totalRuns
            local isTASRun = playbackRunNumber == 2 and selectedDefinition.secondary ~= nil
            local runSuffix = isTASRun and " · TAS" or ""
            statusLabel.Text = string.format("Status: %s (%s — Run %d/%d%s)...",
                selectedObby, runLabel, playbackRunNumber, totalRuns, runSuffix)
            statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)

            startFrameIdx = ensurePlaybackAdvance(variantFrames, startFrameIdx)
            if not startFrameIdx then
                statusLabel.Text = "Status: Playback timeline invalid"
                statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
                break
            end

            -- Start timing only after pathfinding and handoff synchronization.
            local lapStartTime = os.clock()
            local runStartTime = os.clock()
            local startOffsetT = variantFrames[startFrameIdx].t
            local endT = variantFrames[#variantFrames].t
            local baselineMultiplier = math.max(0.01, routeConfig.speed_mult)
            -- The profile is integrated below, rather than recalculated from
            -- elapsed wall time.  Keep a conservative guard for a very slow
            -- approach window immediately before a jump.
            local totalDuration = math.max(0.25, (endT - startOffsetT) / 0.75 + 1.5)
            local virtualTimelineT = startOffsetT

            local currentFramePointer = startFrameIdx
            local jumpCount = 0
            local currentJumpStartTime = -999
            local currentJumpEndTime = -999
            local _, currentHrpYaw = hrp.CFrame:ToOrientation()
            local smoothedFacingYaw = currentHrpYaw
            local lastHeartbeatTime = os.clock()
            local lastAppliedPos = hrp.Position
            local handoffStartPos = hrp.Position
            local handoffStartClock = os.clock()
            local HANDOFF_BLEND_TIME = 0.35
            activeMotionController = activeMotionController or MotionController.new()
            activeMotionController:reset(hrp)

            -- Le facteur caméra est tiré une seule fois pour chaque saut, pas chaque frame.
            -- Fixed left-turn offsets for the first 3 jumps so the camera
            -- behaves consistently like the reference clip instead of changing
            -- angle randomly on every replay.
            local jumpCameraFactors = {
                math.rad(45),
                math.rad(45),
                math.rad(45),
                math.rad(45),
            }

            jumpCameraHardLockYaw = nil
            jumpCameraHardLockJump = 0

            local FAIL_CHANCE = humanMistakesEnabled and HUMAN_MISTAKE_CHANCE or 0
            local willFailThisLoop = false
            if humanMistakesEnabled then
                willFailThisLoop = FORCE_HUMAN_MISTAKE_FOR_TEST
                    or math.random() < FAIL_CHANCE
            end

            -- IMPORTANT: playback starts at startFrameIdx, so jumps that happened
            -- before that frame can never be reached by jumpCount in this loop.
            -- Pick only a jump that actually exists after the handoff frame.
            local futureJumpNumbers = {}
            if willFailThisLoop and #jumpPeakData > 0 then
                for jumpNum, jumpInfo in ipairs(jumpPeakData) do
                    if jumpInfo and jumpInfo.peakIdx and jumpInfo.peakIdx >= startFrameIdx then
                        futureJumpNumbers[#futureJumpNumbers + 1] = jumpNum
                    end
                end
            end

            local failJumpTarget = -1
            if willFailThisLoop and #futureJumpNumbers > 0 then
                failJumpTarget = futureJumpNumbers[math.random(1, #futureJumpNumbers)]
                cumulativeStats.mistakesArmed += 1
                diagnosticJump = failJumpTarget
                diagnosticReason = "Human Mistake armed"
                FORCE_HUMAN_MISTAKE_FOR_TEST = false
                warn(string.format("[HumanMistake] Armed for jump %d this lap.", failJumpTarget))
            else
                -- No future jump available: do not arm a dead failure target.
                willFailThisLoop = false
            end

            local hasFailedThisLoop = false
            local mistakePeakTarget = nil

            local captchaPauseStarted = nil

            while isPlaying and isRunningScript do
                local captchaActive = antiCaptchaEnabled and CaptchaManager and CaptchaManager.IsActive and CaptchaManager.IsActive()
                if captchaActive then
                    if not captchaPauseStarted then
                        captchaPauseStarted = os.clock()
                        statusLabel.Text = "Status: CAPTCHA — Vérification humaine requise..."
                        statusLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
                    end

                    lastHeartbeatTime = os.clock()
                    RunService.Heartbeat:Wait()
                else
                    if captchaPauseStarted then
                        local pauseDuration = math.max(0, os.clock() - captchaPauseStarted)
                        runStartTime += pauseDuration
                        lapStartTime += pauseDuration
                        captchaPauseStarted = nil
                        lastHeartbeatTime = os.clock()
                    end

                local elapsedReal = os.clock() - runStartTime
                if elapsedReal >= totalDuration then break end

                -- This game sends a failed run back to spawn rather than killing
                -- the Humanoid. Detect that discontinuity before the next frame
                -- overwrites it, then restart from the normal checkpoint path.
                local unexpectedDisplacement = (hrp.Position - lastAppliedPos).Magnitude
                if unexpectedDisplacement >= SPAWN_RESET_DISTANCE then
                    warn(string.format(
                        "[Recovery] Spawn reset detected (%.1f studs); restarting pathfinding.",
                        unexpectedDisplacement
                    ))
                    statusLabel.Text = "Status: Spawn reset detected — recovering..."
                    statusLabel.TextColor3 = Color3.fromRGB(230, 126, 34)
                    humanoid:Move(Vector3.zero, false)
                    task.wait(0.5)
                    break
                end

                if humanoid.Health <= 0 or hrp.Position.Y < -40 then
                    statusLabel.Text = "Status: Respawning & Auto-Recovering..."
                    statusLabel.TextColor3 = Color3.fromRGB(230, 126, 34)
                    task.wait(randomDelay(0.35, 0.65))
                    break
                end

                local nowClock = os.clock()
                local dt = math.clamp(nowClock - lastHeartbeatTime, 0.001, 0.05)
                lastHeartbeatTime = nowClock
                diagnosticFrame = currentFramePointer

                local timingScale = baselineMultiplier
                if timingProfile and #timingProfile > 0 then
                    local frameIdxForTiming = math.max(1, math.min(math.floor(currentFramePointer), #timingProfile))
                    timingScale = tonumber(timingProfile[frameIdxForTiming]) or baselineMultiplier
                end
                -- Defensive fallback: never allow a non-positive/invalid time scale.
                if timingScale <= 0 then
                    timingScale = baselineMultiplier > 0 and baselineMultiplier or 1.0
                end
                -- Integrating the local rate makes every jump's real-time
                -- offset depend on this lap's independently generated approach
                -- profile.  It avoids a fixed replay-to-wall-clock mapping.
                virtualTimelineT = math.min(endT, virtualTimelineT + dt * timingScale)
                local targetVirtualT = virtualTimelineT

                while currentFramePointer < #variantFrames and variantFrames[currentFramePointer + 1].t <= targetVirtualT do
                    currentFramePointer += 1
                    local curF = variantFrames[currentFramePointer]
                    if curF.j then
                        jumpCount += 1
                        currentJumpStartTime = curF.t
                        currentJumpEndTime = curF.t + 0.52
                        if jumpCount == failJumpTarget and not hasFailedThisLoop then
                            mistakePeakTarget = jumpPeakData[jumpCount] and jumpPeakData[jumpCount].peakIdx or nil
                        end
                    end
                end

                if targetVirtualT >= endT then
                    break
                end

                if mistakePeakTarget and currentFramePointer >= mistakePeakTarget and not hasFailedThisLoop then
                    hasFailedThisLoop = true
                    cumulativeStats.mistakesTriggered += 1
                    diagnosticReason = "Human Mistake triggered"
                    statusLabel.Text = "Status: Human Mistake (Missed Jump)..."
                    statusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
                    warn("[HumanMistake] Triggered; replay released for native game gravity/reset.")
                    statusLabel.Text = "Status: Human Mistake (released to gravity)..."
                    releaseForHumanMistake(humanoid, hrp)
                    break
                end

                if currentFramePointer >= #variantFrames then
                    currentFramePointer = #variantFrames - 1
                    if currentFramePointer < 1 then break end
                end

                local isAirborne = targetVirtualT >= currentJumpStartTime and targetVirtualT <= currentJumpEndTime
                local fA = variantFrames[currentFramePointer]
                local fB = variantFrames[math.min(#variantFrames, currentFramePointer + 1)]
                local segDuration = fB.t - fA.t
                local alpha = segDuration > 0.0001 and math.clamp((targetVirtualT - fA.t) / segDuration, 0, 1) or 0

                local meta = frameMetadata[currentFramePointer] or {safeFactor = 0}
                local rawPos = fA.c.Position:Lerp(fB.c.Position, alpha)

                -- One-time smooth handoff from the pathfinder's real final
                -- position to the selected playback trajectory.
                local handoffT = math.clamp(
                    (nowClock - handoffStartClock) / HANDOFF_BLEND_TIME, 0, 1
                )
                handoffT = handoffT * handoffT * (3 - 2 * handoffT)
                rawPos = handoffStartPos:Lerp(rawPos, handoffT)

                local exactPos = rawPos + getHumanMicroJitter(nowClock, meta.safeFactor)

                local lookAheadIdx = math.min(#variantFrames, currentFramePointer + 8)
                local lookAheadPos = variantFrames[lookAheadIdx].c.Position
                local moveDir = lookAheadPos - exactPos
                local horizDir = Vector3.new(moveDir.X, 0, moveDir.Z)
                if horizDir.Magnitude > 0.1 then
                    local targetAngle = math.atan2(-horizDir.X, -horizDir.Z)
                    local angleDiff = getShortestAngleDiff(targetAngle, smoothedFacingYaw)
                    local turnResponsiveness = isAirborne and 7.0 or 10.5
                    smoothedFacingYaw = (smoothedFacingYaw + angleDiff * math.clamp(turnResponsiveness * dt, 0, 0.40) + math.pi) % (2 * math.pi) - math.pi
                end

                -- Sur les 3 premiers jumps, c'est le JOUEUR qui tourne.
                -- La rotation est capturée au début du jump et conservée jusqu'à
                -- l'atterrissage. La caméra ne reçoit aucun angle de lock spécial.
                local jumpBodyTurnAngle = 0
                if jumpCount >= 1 and jumpCount <= 4 then
                    local elapsedInJump = targetVirtualT - currentJumpStartTime
                    if elapsedInJump >= 0 and elapsedInJump <= 0.52 then
                        if jumpCameraHardLockJump ~= jumpCount then
                            jumpCameraHardLockJump = jumpCount
                            jumpCameraHardLockYaw = (smoothedFacingYaw
                                + (jumpCameraFactors[jumpCount] or math.rad(45))
                                + math.pi) % (2 * math.pi) - math.pi
                        end
                        local turnCommit = smoothStep(math.clamp(elapsedInJump / 0.12, 0, 1))
                        jumpBodyTurnAngle = getShortestAngleDiff(jumpCameraHardLockYaw, smoothedFacingYaw) * turnCommit
                    end
                else
                    jumpCameraHardLockYaw = nil
                    jumpCameraHardLockJump = 0
                end

                local appliedYaw = smoothedFacingYaw + jumpBodyTurnAngle
                local realVelocity
                if activeMotionController then
                    realVelocity = activeMotionController:apply(hrp, exactPos, appliedYaw, dt)
                else
                    hrp.CFrame = CFrame.new(exactPos) * CFrame.Angles(0, appliedYaw, 0)
                    realVelocity = (exactPos - lastAppliedPos) / math.max(dt, 0.001)
                    hrp.AssemblyLinearVelocity = realVelocity
                end
                lastAppliedPos = exactPos

                local horizontalSpeed = Vector3.new(realVelocity.X, 0, realVelocity.Z).Magnitude

                -- Animation controller: keep the gait driven by the route's actual
                -- ground speed, not by the tiny frame-to-frame CFrame noise.
                -- This avoids the classic “gliding” look when the character is moved
                -- by a replay system instead of Humanoid:MoveTo().
                local WALK_START_SPEED = 1.5
                local WALK_REFERENCE_SPEED = 16.0
                local WALK_MIN_PLAYBACK = 0.65
                local WALK_MAX_PLAYBACK = 1.65

                if isAirborne then
                    if walkTrack.IsPlaying then
                        walkTrack:Stop(0.10)
                    end
                    if idleTrack.IsPlaying then
                        idleTrack:Stop(0.10)
                    end
                    if not jumpTrack.IsPlaying then
                        jumpTrack:Play(0.10, 1.0, 1.0)
                    end
                    jumpTrack:AdjustWeight(1.0, 0.08)
                elseif horizontalSpeed >= WALK_START_SPEED then
                    if jumpTrack.IsPlaying then
                        jumpTrack:Stop(0.12)
                    end
                    if idleTrack.IsPlaying then
                        idleTrack:Stop(0.12)
                    end
                    if not walkTrack.IsPlaying then
                        walkTrack:Play(0.12, 1.0, 1.0)
                    end

                    local playbackRate = math.clamp(
                        horizontalSpeed / WALK_REFERENCE_SPEED,
                        WALK_MIN_PLAYBACK,
                        WALK_MAX_PLAYBACK
                    )
                    walkTrack:AdjustWeight(1.0, 0.06)
                    walkTrack:AdjustSpeed(playbackRate)
                else
                    if jumpTrack.IsPlaying then
                        jumpTrack:Stop(0.12)
                    end
                    if walkTrack.IsPlaying then
                        walkTrack:Stop(0.16)
                    end
                    if not idleTrack.IsPlaying then
                        idleTrack:Play(0.16, 1.0, 1.0)
                    end
                    idleTrack:AdjustWeight(1.0, 0.08)
                end

                updateHumanMouseCamera(
                    exactPos,
                    smoothedFacingYaw + jumpBodyTurnAngle,
                    dt,
                    nowClock,
                    isAirborne
                )
                RunService.Heartbeat:Wait()
                end -- /CAPTCHA GATE
            end

            if walkTrack.IsPlaying then walkTrack:Stop(0.2) end
            if jumpTrack.IsPlaying then jumpTrack:Stop(0.2) end

            local lapDuration = os.clock() - lapStartTime
            if activeMotionController then
                warn(activeMotionController:report("[PlaybackTelemetry]"))
            end
            if lapDuration > 5 then
                totalLapsCompleted += 1
                cumulativeStats.laps += 1
                cumulativeStats.lapSeconds += lapDuration
                saveSettings()
                lastLapTime = lapDuration
                if bestLapTime == 0 or lapDuration < bestLapTime then
                    local oldPB = bestLapTime
                    bestLapTime = lapDuration
                    triggerPBCelebration(bestLapTime, oldPB)
                end
                if worstLapTime == 0 or lapDuration > worstLapTime then
                    worstLapTime = lapDuration
                end

                if totalLapsCompleted >= AUTO_HOP_AFTER_LAPS and not autoHopInProgress then
                    autoHopInProgress = true
                    runEnabled = true
                    saveSettings()
                    statusLabel.Text = string.format(
                        "Status: %d laps reached — hopping server...",
                        AUTO_HOP_AFTER_LAPS
                    )
                    statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
                    task.defer(performServerHop)
                    break
                end
            end

            if not isPlaying or not isLooping or not isRunningScript then break end

            if selectedDefinition.totalRuns >= 2 and playbackRunNumber == 1 and selectedDefinition.secondary then
                playbackRunNumber = 2
                refreshActiveTimeline(selectedDefinition.secondary)
                statusLabel.Text = string.format("Status: %s — next run = TAS", selectedObby)
                statusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
            else
                playbackRunNumber = 1
                refreshActiveTimeline(selectedDefinition.primary)
                statusLabel.Text = string.format("Status: %s — next run = Run 1", selectedObby)
                statusLabel.TextColor3 = Color3.fromRGB(145, 145, 156)
            end

            task.wait(useRandomDelays and (0.35 + math.random() * 0.75) or 0.20)
        end

        stopPlayback()
    end)
end

