            pcall(function()
                connection:Disconnect()
            end)
        end
    end
    table.clear(AntiCaptcha.connections)
end

local function antiCaptchaCleanup()
    antiCaptchaDestroyTrigger()
    antiCaptchaDisableClient()
    antiCaptchaBlockRemoteCallbacks()
end

