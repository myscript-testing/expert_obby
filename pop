CaptchaManager = {
    RequestCaptcha = function()
        return true
    end,
    IsActive = function()
        return false
    end,
    IsEnabled = function()
        return AntiCaptcha.enabled
    end,
    SetEnabled = function(value)
        AntiCaptcha.enabled = value == true
        if AntiCaptcha.enabled then
            antiCaptchaStart()
        else
            antiCaptchaStop()
        end
    end,
    ForceCleanup = antiCaptchaCleanup,
}

