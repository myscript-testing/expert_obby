    local function safeText(value, fallback)
        if value == nil then return fallback or "" end
        local text = tostring(value)
        if text == "" then return fallback or "" end
        return text
    end

    local function getBalloonKey(item)
        if type(item) ~= "table" then return "" end
        return string.lower(safeText(item.balloonKey, item.key or item.name or item.title or "balloon"))
    end

    local function getBalloonName(item)
        if type(item) ~= "table" then return "Balloon" end
        return safeText(item.title, safeText(item.displayName, safeText(item.balloonKey, "Balloon")))
    end

    local function getBalloonValue(item)
        if type(item) ~= "table" then return 0 end
        return tonumber(item.value) or tonumber(item.popValue) or tonumber(item.price) or 0
    end

    local function sameBalloon(a, b)
        return type(a) == "table" and type(b) == "table" and getBalloonKey(a) ~= "" and getBalloonKey(a) == getBalloonKey(b)
    end

    local function fetchInventory()
        if not balloonGetRemote or not balloonGetRemote:IsA("RemoteFunction") then
            return false, "GetBalloonRewards unavailable"
        end
        local ok, result = pcall(function() return balloonGetRemote:InvokeServer() end)
        if not ok or type(result) ~= "table" then return false, "Could not read balloon inventory" end
        local items = result.items
        if type(items) ~= "table" then items = result end
        local clean = {}
        for _, item in ipairs(items) do
            if type(item) == "table" and type(item.id) == "string" and item.id ~= "" then
                clean[#clean+1] = item
            end
        end
        balloonInventory = clean
        return true, "Inventory: " .. tostring(#clean)
    end

    local function inventoryGroups()
        local groups = {}
        for _, item in ipairs(balloonInventory) do
            local key = getBalloonKey(item)
            if key == "" then key = item.id end
            if not groups[key] then groups[key] = {sample=item,count=0} end
            groups[key].count += 1
        end
        return groups
    end

